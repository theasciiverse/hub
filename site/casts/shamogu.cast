[0.041, "o", "\u001b[3;49H\u001b[40m.\u001b[5;47H\u001b[49m\u001b[37m\"\u001b[6;46H\"\u001b[C\u001b[39m\u001b[40m\"\u001b[4C\u001b[49m\u001b[37m.\u001b[1m#\u001b[7;46H\u001b(B\u001b[m\u001b[40m\"\u001b[C\u001b[34m@\u001b[3C\u001b[49m\u001b[37m\u001b[1m◊\u001b(B\u001b[m\u001b[37m^\u001b[8;47H\u001b[39m\u001b[40m\u001b[1m#\u001b[3C\u001b(B\u001b[m\u001b[40m.\"\u001b[9;47H..\u001b[10;47H..\u001b[11;46H\u001b[1m#\u001b(B\u001b[m\u001b[40m..\u001b[12;47H.^\u001b[2C\"\u001b[49m\u001b[37m¤\u001b[13;46H\u001b[39m\u001b[40m\u001b[1m◊\u001b(B\u001b[m\u001b[40m^\u001b[49m\u001b[37m¤\u001b[C\u001b[39m\u001b[40m.\u001b[49m\u001b[37m¤\u001b[14;50H¤\u001b[24;10H\u001b[39m8\u001b[5C\u001b[34m↓\u001b(B\u001b[m"]
