[0.000, "o", "\r\n"]
[0.000, "o", " At your feet all the water of the stream splashes into a five-inch slit in the rock. Downstream\r\n the streambed is bare rock.\r\n \r\n ? "]
[0.000, "o", "\r\u001b[?2004h"]
