[0.021, "o", "\u001b[H\u001b[C\u001b[39;49m\u001b[90m\u001b[40m#.#...........#.#.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \u001b[90m\u001b[40m \r\u001b[2d.#...##.###.##...#.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \u001b[90m\u001b[40m \r\u001b[3d.#.#.#.......#.#.#.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \u001b[90m\u001b[40m \u001b[4;3H.#...##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.#\u001b[90m\u001b[40m#...\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m#..\u001b[90m\u001b[40m.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \u001b[90m\u001b[40m \r\u001b[5d.#.#.#.#.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m..#\u001b[90m\u001b[40m.#.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m#.\u001b[36m\u001b[40m#\u001b[90m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \u001b[90m\u001b[40m \r\u001b[6d.#...#...\u001b[32m\u001b[40m♣\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m...\u001b[90m\u001b[40m#.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m..\u001b[36m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m       \u001b[90m\u001b[40m \r\u001b[7d.#.#.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m  \u001b[90m\u001b[40m#.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m..\u001b[96m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[36m\u001b[40m#\u001b[90m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m#.\u001b[36m\u001b[40m#\u001b[90m\u001b[40m#\u001b[26G \r\u001b[8d...\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m...#..\u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[90m\u001b[40m \r\u001b[9d.#.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m    \u001b[90m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m....\u001b[96m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.#.\u001b[33m\u001b[40m#\u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[90m\u001b[40m \r\u001b[10d.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[90m\u001b[40m#\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m...\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m       \u001b[90m\u001b[40m \r\u001b[11d.#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[90m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m......\u001b[96m\u001b[40m#\u001b[30m\u001b[47m@\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[26G\u001b[90m\u001b[40m \r\u001b[12d#..#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m    \u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[36m\u001b[40m###\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[12;26H\u001b[90m\u001b[40m \r\u001b[13d#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m        ........\u001b[96m\u001b[40m#\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[90m\u001b[40m \r\u001b[14d#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[10G##.\u001b[36m\u001b[40m###\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[90m\u001b[40m \r\u001b[15d.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[10G..\u001b[90m\u001b[40m.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m  \u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m....      \u001b[90m\u001b[40m \r\u001b[16d."]
