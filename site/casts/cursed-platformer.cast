[0.000, "o", "x\u000f\u001b[39;49m\u001b[37m\u001b[40m I enjoy jumping. I enjoy it a lot! In fact, I can    \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[12;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m jump three times my own height! \u001b[12;73H"]
[0.000, "o", "     \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[13;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[13;72H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40m\u000f\u001b[39;49m\u001b[37m\u001b[40m      \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[14;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40m"]
[0.000, "o", "x\u000f\u001b[39;49m\u001b[37m\u001b[40m Just hit Spacebar, Up arrow or (A) to let me do      \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[15;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m that. Pretty please?\u001b[15;61H"]
