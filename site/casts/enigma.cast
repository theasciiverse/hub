[0.000, "o", "m\u001b[40m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[37m   \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[39m\u001b[49m\u001b[K\u001b[18;20H\u001b[1K\u001b[37m\u001b[40m\u001b[C \u001b[39m\u001b[49m\u001b[11X\u001b[37m\u001b[44m\u001b[11C+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[31mv\u001b[33m.\u001b[31mv\u001b[37m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[37m   \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[39m\u001b[49m\u001b[K\u001b[19;20H\u001b[1K\u001b[37m\u001b[40m\u001b[C \u001b[39m\u001b[49m\u001b[11X\u001b[36m\u001b[44m\u001b[11C|\u001b[31m\u001b[40mv\u001b[37m  \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[31mvvv\u001b[33m.\u001b[37m\u001b[44m+\u001b[33m\u001b[40m\u001b[1m$$$$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[39m\u001b[49m\u001b[K\u001b[20;20H\u001b[1K\u001b[37m\u001b[40m\u001b[C \u001b[39m\u001b[49m\u001b[11X\u001b[36m\u001b[44m\u001b[11C|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m  \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m \u001b[33m.\u001b[37m