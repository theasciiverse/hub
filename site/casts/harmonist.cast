[2.199, "o", "\u001b[H\u001b[33mYou see a queenstone. You see a magic potion.\u001b[36m Press SPACE for menu and ? for\r\nhelp. Good luck!\r\n\u001b[37m                                                                                \r\n                                                                                \r\n                                                                                \r\n                                                                                \r\n                                                                                \r\n                                                                                \r\n                                                                                \r\n                                                                                \r\n                                                                                \r\n   ¤                   \u001b[C                                                        \r\n  \u001b[39m\u001b[40m\u001b[1m#\u001b(B\u001b[m\u001b[35m\u001b[40m+\u001b[39m\u001b[1m#\u001b(B\u001b[m\u001b[37m¤                 \u001b[C                                                        \r\n \u001b[39m\u001b[40m\u001b[1m#\u001b(B\u001b[m\u001b[35m\u001b[40m∩\u001b[39m..\u001b[94mΠ\u001b[49m\u001b(B\u001b[m\u001b[37m¤                                                                         \r\n \u001b[39m\u001b[40m\u001b[1m#\u001b(B\u001b[m\u001b[36m\u001b[40m?\u001b[39m..\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \r\n \u001b[39m\u001b[40m\u001b[1m#\u001b(B\u001b[m\u001b[40m.\u001b[34m@\u001b[39m.\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \r\n¤\u001b[35m\u001b[40m+\u001b[39m.\u001b[33mπ\u001b[39m.\u001b[35m+\u001b[49m\u001b[37m¤                                                                         \r\n \u001b[39m\u001b[40m\u001b[1m#\u001b(B\u00