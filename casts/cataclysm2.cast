[0.001, "o", "\u001b[32m\u001b[40m......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \r\u001b[16d  \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[37m\u001b[40m@\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[17;3H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[7b\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m...\u001b[37m\u001b[40m#\r\u001b[18d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[12G.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[37m\u001b[40m#\u001b[36m\u001b[40m...\u001b[37m\u001b[40m#\r\u001b[19d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m  \u001b[36m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[20;7H\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[6b\u001b[32m\u001b[40m..\u001b[37m\u001b[40m#\u001b[30m\u001b[40m     \r\u001b[21d\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u00