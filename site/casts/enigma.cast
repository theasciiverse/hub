01b[33m:\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[39m\u001b[49m\u001b[K\u001b[24;20H\u001b[1K\u001b[37m\u001b[40m\u001b[C            \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m  \u001b[31mv\u001b[37m      \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m..\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m          \u001b[33m...\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[39m\u001b[49m\u001b[K\u001b[25;20H\u001b[1K\u001b[37m\u001b[40m\u001b[C            \u001b[44m+\u001b[36m-\u001b[37m+\u001b[36m---------\u001b[37m+\u001b[36m-\u001b[37m+\u001b[36m---\u001b[37m+\u001b[36m-\u001b[37m+\u001b[36m--------------\u001b[37m+\u001b[40m            \u001b[39m\u001b[49m\u001b[K\u001b[26;20H\u001b[1K\u001b[37m\u001b[40m\u001b[C            \u001b[36m1) \u001b[33mDarkness Falls\u001b[37m              \u001b[33m 1\u001b[36m/\u001b[33m61\u001b[37m            \u001b[39m\u001b[49m\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[?12l\u001b[?25h\u001b[H"]
