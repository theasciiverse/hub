[0.017, "o", "\u001b[8;14H\u001b[38;2;255;176;0;48;2;8;8;12m╭───────────\u001b[8;76H───────────╮\u001b[9;14H│\u001b[39;48;2;8;8;12m           \u001b[9;76H           \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[10;14H│\u001b[39;48;2;8;8;12m           \u001b[10;76H           \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[11;14H│\u001b[39;48;2;8;8;12m           \u001b[11;76H           \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[12;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mFive o'clock, and behind\u001b[12;42Hthe high score table the hatch opens onto\u001b[39;48;2;8;8;12m    \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[13;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12msomething warm and humming: the Power Supply. PAYLOAD was in the\u001b[39;48;2;8;8;12m      \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[14;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mold game all along, a virus asleep on its disk for thirty years,\u001b[39;48;2;8;8;12m      \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[15;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mwaiting for somebody to play. At six the machine's modem dials out\u001b[39;48;2;8;8;12m    \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[16;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mfor the mail, and Payload means to go out with it, onto the line and\u001b[39;48;2;8;8;12m  \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[17;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12minto every machine at the other end. Here it is running the power\u001b[39;48;2;8;8;12m     \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[18;14H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mup. Mind the wires: watch the current coming, and step over between.\u001b[39;48;2;8;8;12m  \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[19;14H│\u001b[39;48;2;8;8;12m           \u001b[19;76H           \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[20;14H│\u001b[39;48;2;8;8;12m           \u001b[20;76H           \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[21;14H│\u001b[39;48;2;8;8;12m           \u001b[21;76H           \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[22;14H╰───────────\u001b[22;76H───────────╯\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
