[0.001, "o", "\u001b[33m\u001b[HYou see a magic potion.\u001b[36m Press SPACE for menu and ? for help. Good luck!\u001b[39m         \u001b[K\u001b[33m\r\n•\u001b[39m You stand at the door.                                                        \u001b[K\u001b[37m\r\n                                                                                \u001b[39m\u001b[K\u001b[37m\r\n                                                                                \u001b[39m\u001b[K\u001b[37m\r\n                                                                                \u001b[39m\u001b[K\u001b[37m\r\n       ¤                                                                        \u001b[39m\u001b[K\u001b[37m\r\n    ¤¤¤\u001b[33m\u001b[40m,\u001b[49m\u001b[37m¤                                                                       \u001b[39m\u001b[K\u001b[37m\r\n  ¤¤\u001b[33m\u001b[40m\"\",\u001b[49m\u001b[37m,,¤                                                                      \u001b[39m\u001b[K\u001b[37m\r\n ¤\u001b[39m\u001b[40m\"\u001b[33m\"..\u001b[49m\u001b[37m.¤¤                                                                       \u001b[39m\u001b[K\u001b[37m\r\n¤\u001b[39m\u001b[40m\"\u001b[33m..\u001b[49m\u001b[37m.¤¤                                                                         \u001b[39m\u001b[K\u001b[40m\u001b[1m\r\n#\u001b(B\u001b[m\u001b[40m\".\u001b[1m#\u001b(B\u001b[m\u001b[37m¤                                                                           \u001b[39m\u001b[K\u001b[40m\r\n.\u001b[34m@\u001b[39m..\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                           \u001b[39m\u001b[K\u001b[40m\r\n.\"\u001b[1m#\u001b(B\u001b[m\u001b[35m\u001b[40m+\u001b[39m\u001b[1m#\u001b(B\u001b[m\u001b[37m¤                                                                          \u001b[39m\u001b[K\u001b[40m\r\n.\u001b[1m#\u001b(B\u001b[m\u001b[35m∩\u001b[37m..\u001b[94mΠ\u001b(B\u001b[m\u001b[37m¤                                                                         \u001b[39m\u001b[K\u001b[40m\r\n.\u001b[49m\u001b[37m\u001b[1m#\u001b(B\u001b[m\u001b[36m?\u001b[37m..\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \u001b[39m\u001b[K\u001b[40m\r\n.\u001b[49m\u001b[37m\u001b[1m#\u001b(B\u001b[m\u001b[37m...\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \u001b[39m\u001b[K\u001b[37m\r\n.\u001b[35m+\u001b[37m.\u001b[33mπ\u001b[37m.\u001b[35m+\u001b[37m¤                                                                         \u001b[39m\u001b[K\u001b[37m\u001b[1m\r\n##\u001b(B\u001b[m\u001b[37m...\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \u001b[39m\u001b[K\u001b[37m\r\n \u001b[1m#\u001b(B\u001b[m\u001b[34m!\u001b[37m..\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \u001b[39m\u001b[K\u001b[37m\r\n  \u001b[1m#\u001b(B\u001b[m\u001b[37m.\u001b[36m∩\u001b[37m\u001b[1m#\u001b(B\u001b[m\u001b[37m                                                                          \u001b[39m\u001b[K\u001b[37m\r\n   \u001b[1m##\u001b(B\u001b[m\u001b[37m                                                                           \u001b[39m\u001b[K\u001b[37m\r\n                                                                                \u001b[39m\u001b[K\u001b[37m\r\n                                                                                \u001b[39m\u001b[K\r\n D:1 T:9 HP:\u001b[32m♥♥♥♥\u001b[39m MP:\u001b[34m♥♥♥♥♥\u001b[39m \u001b[33m)\u001b[39m:1/4 [M][I][V]| \u001b[34mH+\u001b[39m                                   \u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[24;9H"]
[0.040, "o", "\u001b[5d\u001b[37m¤\u001b[6;9H\u001b[33m\u001b[40m,\u001b[49m\u001b[37m¤\u001b[7;9H\u001b[33m\u001b[40m,,\u001b[49m\u001b[37m¤\u001b[8;2H¤\u001b[2C\"\u001b[2C\u001b[33m\u001b[40m,,,,\u001b[49m\u001b[37m¤\r\n¤\u001b[39m\u001b[40m\"\u001b[4C\u001b[33m....\u001b[49m\u001b[37m¤\r\n\u001b[39m\u001b[40m\u001b[1m#\u001b[3C\u001b(B\u001b[m\u001b[33m\u001b[40m..\u001b[C\u001b[49m\u001b[37m¤¤¤\u001b[11;2H\u001b[34m\u001b[40m@\u001b[3C\u001b[49m\u001b[37m¤\u001b[12;2H\u001b[39m\u001b[40m.\u001b[14;2H\u001b[49m\u001b[37m\u001b[1m#\u001b[17;1H\u001b(B\u001b[m\u001b[40m.\r\n\u001b[1m#\u001b[24;8H\u001b(B\u001b[m10 HP:\u001b[3C\u001b[32m♥\u001b[39m MP:\u001b[4C\u001b[34m♥\u001b[39m \u001b[33m)\u001b[39m:1/4 [M][I][V]| \u001b[34mH+\u001b[C\u001b[39m\""]
