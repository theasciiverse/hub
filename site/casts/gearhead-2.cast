[0.309, "o", "\u001b[2;18H\u001b[37m\u001b[40m \u001b[14C\u001b[33m\u001b[1m#\u001b[3;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[4CV\u001b[C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[6C\u001b[33m\u001b[1m#\u001b[4;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#%#\u001b(B\u001b[m\u001b[37m\u001b[40mE_=\u001b[33m\u001b[1m#\u001b[5;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#+#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[6;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[4C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[7;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#-\u001b[2C#\u001b[8;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[9C\u001b[34m.\u001b[33m\u001b[1mM\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[9;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[13C\u001b[34m.\u001b[33m\u001b[1m#\u001b[10;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[13C\u001b[34m.\u001b[33m\u001b[1m#\u001b[11;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#+\u001b[2C#\u001b[12;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#\u001b[13;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m+\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[14;18H\u001b(B\u001b[m\u001b[37m\u001b[40m \u0