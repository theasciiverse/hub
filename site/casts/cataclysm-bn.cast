[0.337, "o", "\u001b[H\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[17G\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[1;40H\u001b(B\u001b[0m\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m',#\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\r\u001b[2d..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[2;27H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[2;39H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\r\u001b[3d\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[3;26H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[3;38H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[34m\u001b[40m~\r\u001b[4d\u001b[32m\u001b[40m......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[4;25H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[4;37H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[4;49H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,,\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[32m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\r\u001b[5d...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[13G\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[5;36H\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,'\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m.\u001b[96G\u001b(B\u001b[0m\u001b[37m\u001b[40m12\r\u001b[6d\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[11G\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[6;23H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[6;35H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[49G\u001b(B\u001b[0;1m\u001b[31m\u001b[40mf\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[42m#\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\r\u001b[7d\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[7;22H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[7;34H\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m',\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'f,\r\u001b[8d....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[8;21H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[8;33H\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[47G\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m...\u001b[32m\u001b[40m,\r\u001b[9d.\u001b[9G\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[9;32H\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[41G"]
[0.000, "o", "\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[49G,,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\r\u001b[10d....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[10;19H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[10;31H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[10;43H"]
