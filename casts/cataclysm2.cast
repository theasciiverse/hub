[0.000, "o", "\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[6b\u001b[33m\u001b[40m....\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b[3;2H"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b[32m\u001b[40m..\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[25G.\u001b[37m\u001b[40m#\u001b[4;3H\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m&&\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m  \u001b[33m\u001b[40m+\u001b[5;4H\u001b[30m\u001b[40m  \u001b[32m\u001b[40m..\u001b[30m\u001b[40m \u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[36m\u001b[40m.\u001b[6;5H\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[7;2H\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[7b\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b[8;2H\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[14G\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[37m\u001b[40m#\r\u001b[9d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[10;3H\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[6b\u001b[32m\u001b[40m..\u001b[37m\u001b[40m#\r\u001b[11d\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m{\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b[12;2H\u001b[33m\u001b[40m..\u001b[30m\u001b[40m  \u001b[32m\u001b[40m......\u001b[33m\u001b[40m......\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[36m\u001b[40m...\u001b[37m\u001b[40m#\r\u001b[13d\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m...\u001b[14;2H\u001b[37m\u001b[40m*\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[37m\u001b[40m#\u001b[30m\u001b[40m   \r\u001b[15d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[16;3H\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[37m\u001b[40m@\u001b[32m\u001b[40m&\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\r\u001b[17d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b[32m\u001b[40m...\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[18;6H\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\r\u001b[19d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m  \u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\r\u001b[20d.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[30m\u001b[40m   \u001b[33m\u001b[40m.\u001b[9b\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\r\u001b[21d"]
