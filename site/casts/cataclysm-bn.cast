[0.000, "o", "..\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m7\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[97G\u001b(B\u001b[0;1m\u001b[30m\u001b[40m│\u001b[37m\u001b[40m+\r\u001b[12d\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[30m\u001b[40m...........\u001b[33m\u001b[40m::\u001b[30m\u001b[40m..........\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.........\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[33m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m7\u001b[96G\u001b(B\u001b[0m\u001b[32m\u001b[40mF\u001b(B\u001b[0;1m\u001b[30m\u001b[40m└┘\r\u001b[13d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.......................\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[34m\u001b[42m#\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[13;71H\u001b[37m\u001b[40m7\r\u001b[14d\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..........\u001b[33m\u001b[40m::\u001b[30m\u001b[40m..........\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b