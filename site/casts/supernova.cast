[0.001, "o", "\u001b[28;2H\u001b[0;35;40m»\u001b[29;2H\u001b[0;96;40mTime passes\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;96;40m                                                                                                  \u001b[0;37;44m│\u001b[28;13H\u001b[0;96;40m."]
