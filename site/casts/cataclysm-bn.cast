[0.432, "o", "\u001b[1;4H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.......\u001b[1;24H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[1;36H..\u001b(B\u001b[0m\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m',#\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[33m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[2;3H.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[2;23H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[33m\u001b[40m::\u001b[2;35H\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\r\u001b[3d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[3;22H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[33m\u001b[40m::\u001b[3;34H\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[34m\u001b[40m~\r\u001b[4d\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[4;23H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m::\u001b[4;33H\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m............\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,,\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[32m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[30m\u001b[40mo\r\u001b[5d\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m........\u001b[5;20H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[5;32H..\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,'\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m..\u001b[34m\u001b[40m~\u001b[96G\u001b(B\u001b[0m\u001b[37m\u001b[40m60\r\u001b[6d\u001b[32m\u001b[40m........\u001b[33m\u001b[40m.\u001b[6;19H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[33m\u001b[40m::\u001b[6;31H\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m........\u001b(B\u001b[0;1m\u001b[31m\u001b[40mf\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[42m#\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\r\u001b[7d..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[18G..\u001b[33m\u001b[40m::\u001b[7;30H\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\