[0.000, "o", "\u001b[11C\u001b(B\u001b[m\u001b[37m\u001b[44m+\u001b[36m--\u001b[37m+\u001b[36m--\u001b[37m+\u001b[36m-\u001b[37m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[14;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m \u001b[31mv\u001b[37m \u001b[31mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m..\u001b[31mv\u001b[37m   \u001b[31mv\u001b[33m..\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[33m\u001b[40m..\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[15;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m   \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[31m\u001b[40mvv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m        \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[44m+\u001b[40m \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[16;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[37m\u001b[40m  \u001b[1m@\u00