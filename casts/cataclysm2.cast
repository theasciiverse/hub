[0.001, "o", "\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m  \r\u001b[6d\u001b[32m\u001b[40m.\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[7;3H\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m&&\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m  \u001b[33m\u001b[40m+\u001b[8;4H\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[36m\u001b[40m.\u001b[30m\u001b[40m   \u001b[9;4H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[36m\u001b[40m.\u001b[30m\u001b[40m    \r\u001b[10d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m  \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[7b\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m   \r\u001b[11d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[15G.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \r\u001b[12d\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \r\u001b[13d\u001b[32m\u001b[40m..\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[6b\u001b[32m\u001b[40m..\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \r\u001b[14d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[15;2H\u001b[32m\u001b[40m.\u001b[6b\u001b[33m\u001b[40m......\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[36m\u001b[40m...\u001b[37m\u001b[40m#\r\u001b[16d\u001b[30m\u001b[40m   \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[37m\u001b[40m@\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m...\u001b[37m\u001b[40m#\r\u001b[17d\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[37m\u001b[40m#\u001b[36m\u001b[40m...\u001b[33m\u001b[40m+\u001b[30m\u001b[40m \u001b[18;5H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m     \u001b[19;5H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40mZ\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[37m\u001b[40m#\u001b[30m\u001b[40m \r\u001b[20d\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \r\u001b[21d  \u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\r\u001b[22d\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[30m\u001b[40m \u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\r\u001b[23d\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[8b\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\r\u001b[24d\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[6b\r\u001b[25d.\u001b[30m\u001b[40m  \u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m......\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\r\u001b[26d\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.....\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[6b\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[27;4H..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[27G\u001b[33m\u001b[40m.\r\u001b[28d..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.."]
