[0.412, "o", "\u001b[H\u001b[33m\u001b[40m7\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.......\u001b[1;29H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[1;42H\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m',#\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\r\u001b[2d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[2;43H\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\r\u001b[3d,...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[3;39H.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\r\u001b[4d\u001b[32m\u001b[40m,......\u001b[33m\u001b[40m.\u001b[4;26H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m::\u001b[4;41H\u001b(B\u001b[0m\u001b[32m\u001b[40m.........\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,,\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[32m\u001b[40mf\r\u001b[5d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[13G\u001b[32m\u001b[40m.\u001b[5;25H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[5;38H\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,'\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[6;2H\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m........\u001b[33m\u001b[40m.\u001b[6;37H.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m........\u001b(B\u001b[0;1m\u001b[31m\u001b[40mf\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[42m#\u001b[33m\u001b[40m.\r\u001b[7d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[7;40H..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m',\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'f\r\u001b[8d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m#\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[8;22H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m::\u001b[8;34H\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m........\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m...\u001b[32m\u001b[40m,,\u001b[8;65H\u001b(B\u001b[0;1m\u001b[37m\u001b[40mroad\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m        \u001b[98G\u001b(B\u001b[0;1m\u001b[30m\u001b[40m┌──\u001b[9;2H\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b[9;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[9;33H\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[42G.\u001b[32m\u001b[40m.......,,\u001b[33m\u001b[40