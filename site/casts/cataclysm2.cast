u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[30m\u001b[40m  \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\r\u001b[20d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[30m\u001b[40m   \u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\r\u001b[21d\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[33m\u001b[40m...\u001b[32m\u001b[40m..\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m....\u001b[30m\u001b[40m   \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\u001b[22;2H\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[30m\u001b[40m   \u001b[23;4H\u001b[32m\u001b[40m....\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[32m\u001b[40m...\u001b[33m\u001b[40m....\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[30m\u001b[40m   \r\u001b[24d\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m   \r\u001b[25d\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m...\u001b[30m\u001b[40m \u001b[33m\u001b[40m....\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b[26;2H\u001b(B\u001b[0m\u001b[33m\u001b[40m....\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\r\u001b[27d"]
