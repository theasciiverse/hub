[0.050025, "o", "\u001b[H\n\n\n\n\n\n\n\n\n                       \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m^\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m                                  \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m^\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m             \u001b[K\r\n                       \u001b[38;5;34m \u001b[0m\u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m\u001b[38;5;34m \u001b[0m                                  \u001b[38;5;34m \u001b[0m\u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m\u001b[38;5;34m \u001b[0m             \u001b[K\r\n                       \u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m                                  \u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m             \u001b[K\r\n                       \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m|\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m                                  \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m|\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m             \u001b[K\r\n\n\n                                                                        \u001b[1;31m[\u001b[0m\u001b[1;31mX\u001b[0m\u001b[1;31mJ\u001b[0m\u001b[1;31m]\u001b[0m    \u001b[K\r\n\n\n        \u001b[1;38;5;226m \u001b[0m\u001b[1;38;5;226m(\u001b[0m\u001b[1;38;5;226mo\u001b[0m\u001b[1;38;5;226m>\u001b[0m\u001b[1;38;5;226m-\u001b[0m\u001b[1;38;5;226m-\u001b[0m\u001b[1;38;5;226m=\u001b[0m           \u001b[1;38;5;160m \u001b[0m\u001b[1;38;5;160m(\u001b[0m\u001b[1;38;5;160mX\u001b[0m\u001b[1;38;5;160m)\u001b[0m\u001b[1;38;5;160m \u001b[0m                                                 \u001b[K\r\n        \u001b[1;38;5;226