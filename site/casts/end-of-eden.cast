[0.001, "o", "\u001b[H                                                                                                                \u001b[2;1H      \u001b[38;2;155;34;38m┏━━━━━━━━━━━━━━┓\u001b[39m                                                                                          \u001b[3;1H      \u001b[38;2;155;34;38m┃\u001b[39m \u001b[38;2;255;255;255mWaking up...\u001b[39m \u001b[38;2;155;34;38m┃\u001b(B\u001b[m\u001b[38;2;54;54;54m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[39m      \u001b[4;1H      \u001b[38;2;155;34;38m┗━━━━━━━━━━━━━━┛\u001b[39m                                                                                          \u001b[5;1H                                                                                                                \u001b[6;1H         \u001b[38;5;252mYou wake up in a dimly lit room, the faint glow of a red emergency light casting an eerie hue   \u001b[39m       \u001b[7;1H         \u001b[38;5;252mover the surroundings. The air is musty and stale, the metallic scent of the cryo-chamber still \u001b[39m       \u001b[8;1H         \u001b[38;5;252mlingering in your nostrils. You feel groggy and disoriented, your mind struggling to process    \u001b[39m       \u001b[9;1H         \u001b[38;5;252mwhat's happening.                                                                               \u001b[39m       \u001b[10;1H         \u001b[38;5;252m                                                                                                \u001b[39m       \u001b[11;1H         \u001b[38;5;252mAs you try to sit up, you notice that your body is stiff and unresponsive. It takes a few       \u001b[39m       \u001b[12;1H         \u001b[38;5;252mmoments for your muscles to warm up and regain their strength. Looking around, you see that the \u001b[39m       \u001b[13;1H         \u001b[38;5;252mwalls are made of a dull gray metal, covered in scratches and scuff marks. There's a faint      \u001b[39m       \u001b[14;1H         \u001b[38;5;252mhumming sound coming from somewhere, indicating that the facility is still operational.         \u001b[39m       \u001b[15;1H         \u001b[38;5;252m                                                                                                \u001b[39m       \u001b[16;1H         \u001b[38;5;252mYou try to remember how you ended up here, but your memories are hazy and fragmented. The last  \u001b[39m       \u001b[17;1H         \u001b[38;5;252mthing you recall is a blinding flash of light and a deafening boom. You must have been caught in\u001b[39m       \u001b[18;1H         \u001b[38;5;252mone of the nuclear explosions that devastated the world.                                        \u001b[39m       \u001b[19;1H         \u001b[38;5;252m                                                                                                \u001b[39m       \u001b[20;1H         \u001b[38;5;252mAs you struggle to gather your bearings, you notice a blinking panel on the wall, with the words\u001b[39m       \u001b[21;1H         \u001b[38;2;155;34;38m\u001b[1m\u001b[3m\"Cryo Sleep Malfunction\"\u001b(B\u001b[m\u001b[38;5;252m displayed in bold letters. It seems that the system has finally        \u001b[39m       \u001b[22;1H         \u001b[38;5;252mdetected the error that caused your prolonged slumber and triggered your awakening.             \u001b[39m       \u001b[23;1H         \u001b[38;5;252m                                                                                                \u001b[39m       \u001b[24;1H         \u001b[38;5;252m\u001b[1mShortly after you realize that you are not alone...\u001b(B\u001b[m\u001b[38;5;252m                                             \u001b[39m       \u001b[25;1H                                                                                                                \u001b[26;1H                                                                                                  \u001b[38;2;155;34;38m┏━━━━━━┓\u001b[39m      \u001b[27;1H      \u001b[38;2;54;54;54m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"]
[0.000, "o", "━━━━━━━━━━━━━━━━━━━\u001b(B\u001b[m\u001b[38;2;155;34;38m┃\u001b[39m \u001b[38;2;255;255;255mNaN%\u001b[39m \u001b[38;2;155;34;38m┃\u001b[39m      \u001b[28;1H                                                                                                  \u001b[38;2;155;34;38m┗━━━━━━┛\u001b[39m      \u001b[29;1H     \u001b[38;2;239;35;60m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\u001b[39m     \u001b[30;1H     \u001b[38;2;239;35;60m┃\u001b[39m \u001b[38;2;255;255;255m1. Try to find a weapon. \u001b[1m\u001b[4m[Find melee weapon]\u001b(B\u001b[m\u001b[38;2;255;255;255m \u001b(B\u001b[m\u001b[38;5;161m\u001b[1m\u001b[4m[Take 4 damage]\u001b(B\u001b[m                                       \u001b[38;2;239;35;60m┃\u001b[39m     \u001b[31;1H     \u001b[38;2;239;35;60m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\u001b[39m     \u001b[32;1H     \u001b[38;2;54;54;54m┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\u001b[39m     \u001b[33;1H     \u001b[38;2;54;54;54m┃\u001b[39m \u001b[38;2;255;255;255m2. Gather your strength and attack it!\u001b[39m                                                             \u001b[38;2;54;54;54m┃\u001b[39m     \u001b[34;1H     \u001b[38;2;54;54;54m┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\u001b[39m     \u001b[35;1H                                                                                                                \u001b[36;1H                                                                                                                \u001b[36;1H"]
