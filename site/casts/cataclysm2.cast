[0.000, "o", "\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[30m\u001b[40m  \u001b[37m\u001b[40m.\r\u001b[3d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[30m\u001b[40m  \u001b[37m\u001b[40m.\r\u001b[4d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[30m\u001b[40m  \u001b[37m\u001b[40m.\r\u001b[5d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[30m\u001b[40m\u001b[16X\r\u001b[6d \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[6b\u001b[32m\u001b[40m..\u001b[30m\u001b[40m  \u001b[37m\u001b[40m#\u001b[30m\u001b[40m \u001b[37m\u001b[40m#\u001b[8b\u001b[30m\u001b[40m \u001b[37m\u001b[40m##\u001b[30m\u001b[40m  \u001b[7;3H\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.....\u001b[30m\u001b[40m  \u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[30m\u001b[40m   \r\u001b[8d    \u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[30m\u001b[40m \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[30m\u001b[40m \u001b[33m\u001b[40m.\u001b[30m\u001b[40m    \u001b[9;2H    \u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u0