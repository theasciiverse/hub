[0.016215, "o", "\u001b[2;4H\u001b[1m\u001b[38;2;255;176;0;48;2;12;12;16m4\u001b[2;11Hco\u001b[2;14Hd Bull Run \u001b[2;36H\u001b[38;2;222;216;200;48;2;12;12;16mOrders\u001b[2;43H\u001b[22m\u001b[38;2;70;68;62;48;2;12;12;16m───────\u001b[3;3H\u001b[38;2;128;124;114;48;2;12;12;16mA\u001b[3;5Hgust 28-30, 1862\u001b[38;2;222;216;200;48;2;12;12;16m    \u001b[3;35H\u001b[38;2;128;124;114;48;2;12;12;16mRead the situation, then press Enter\u001b[4;3H\u001b[38;2;222;216;200;48;2;12;12;16mPope hammers at Jackson    \u001b[4;35H\u001b[38;2;128;124;114;48;2;12;12;16mto spend the army's money: food and\u001b[5;4H\u001b[38;2;222;216;200;48;2;12;12;16mlong \u001b[5;10Hn unfin\u001b[5;18Hshed railroad\u001b[5;35H\u001b[38;2;128;124;114;48;2;12;12;16mpay keep the men in good heart,\u001b[6;3H\u001b[38;2;222;216;200;48;2;12;12;16mcut while Longstreet arrives\u001b[6;35H\u001b[38;2;128;124;114;48;2;12;12;16mammunition\u001b[6;46Hmakes their fire tell.\u001b[6;75H\u001b[38;2;222;216;200;48;2;12;12;16mSeven Days       \u001b[7;3Hu\u001b[7;5Hseen on\u001b[7;13Hhis\u001b[7;17Hflank, then\u001b[7;35H\u001b[38;2;128;124;114;48;2;12;12;16mThen choose how to fight.\u001b[7;75H\u001b[1m\u001b[38;2;255;176;0;48;2;12;12;16mSecond Bull Run  \u001b[8;3H"]
