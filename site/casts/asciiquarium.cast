[0.101, "o", "\u001b[13;3H\u001b(B\u001b[0;1m\u001b[36m\u001b[40mo\u001b[14;30H\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[1K\u001b[15d \u001b[1K\r\u001b[16d\u001b[1P\u001b[17d\u001b[1P\u001b[18;63H\u001b(B\u001b[0;1m\u001b[37m\u001b[40mo\u001b[36m\u001b[40m:\u001b[71G;;///\u001b[30m\u001b[40m \u001b[19;4H\u001b[36m\u001b[40m.\u001b[19;62H\u001b(B\u001b[0m\u001b[34m\u001b[40m>\u001b(B\u001b[0;1m\u001b[36m\u001b[40m:\u001b[71G;;\\\\\\\u001b[30m\u001b[40m \u001b[20;63H\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[1K \u001b(B\u001b[0;1m\u001b[36m\u001b[40m''\u001b[34m\u001b[40m\\\\\\\\\\\u001b[36m\u001b[40m''\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m';\\\u001b[30m\u001b[40m \u001b[23;67H\u001b[33m\u001b[40m,\u001b(B\u001b[0m\u001b[36m\u001b[40m/\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[30m\u001b[40m]\u001b[24;65H\u001b[33m\u001b[40m<\u001b[37m\u001b[40m'\u001b[36m\u001b[40m)\u001b(B\u001b[0m\u001b[37m\u001b[40m   \u001b(B\u001b[0;1m\u001b[33m\u001b[40m`\u001b[36m\u001b[40m=<\u001b[30m\u001b[40m-\u001b[25;68H\u001b(B\u001b[0m\u001b[31m\u001b[40m\\\u001b(B\u001b[0;1m\u001b[33m\u001b[40m```\u001b[30m\u001b[40m_\u001b[28;37H\u001b(B\u001b[0m\u001b[32m\u001b[40m )\u001b[29d\b\b(\u001b[37m\u001b[40m \u001b[30d\b\b\u001b[32m\u001b[40m )\u001b[100G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[0.101, "o", "\r\u001b[5d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m >\u001b[12d\u001b[36m\u001b[40mo\u001b[13;30H\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[1K\r\u001b[1P\u001b[14d\u001b[1P\u001b[15;31H\u001b[35m\u001b[40m`\u001b[37m\u001b[40m\u001b[K\r\u001b[16d\u001b[1P\u001b[17d\u001b[1P\u001b[18;4H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m.\u001b[18;62H\u001b[37m\u001b[40mo\u001b[36m\u001b[40m:\u001b[70G;;///\u001b[30m\u001b[40m \u001b[19;60H\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[1K \u001b[34m\u001b[40m>\u001b(B\u001b[0;1m\u001b[36m\u001b[40m:\u001b[70G;;\\\\\\\u001b[30m\u001b[40m \u001b[20;63H\u001b[36m\u001b[40m''\u001b[34m\u001b[40m\\\\\\\\\\\u001b[36m\u001b[40m''\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m';\\\u001b[30m\u001b[40m \u001b[21;87H\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b(B\u001b[0;1m\u001b[31m\u001b[40m__\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[K\u001b[22;88H\u001b(B\u001b[0;1m\u001b[34m\u001b[40m<\u001b[37m\u001b[40m'\u001b[31m\u001b[40m_>\u001b(B\u001b[0m\u001b[32m\u001b[40m<\u001b(B\u001b[0;1m\u001b[30m\u001b[40m \u001b[23;89H\u001b[31m\u001b[40m`\u001b[30m\u001b[40m \u001b[25;2H"]
