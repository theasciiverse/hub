[0.707, "o", "\r\u001b[22d\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[4M\u001b[26d \u001b[90m\u001b[40mYou barely miss the ball python.\u001b[27;2H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40mThe ball python bites you but does no damage.\r\u001b[28d \u001b[91m\u001b[40mThe ball python constricts you.\u001b[29;2H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40mThe ball python bites you but does no damage.\u001b[9;64H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m4.2\u001b[1;38H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\r\u001b[22d\u001b[M\u001b[29d_\u001b[91m\u001b[40mThe ball python constricts you.\u001b[11;17H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
