[0.098, "o", "\r\u001b(B\u001b[0;1m\u001b[37m\u001b[40m shoot a portal on the opposite wall. Then you can walk though one portal into the other. \u001b(B\u001b[0m\u001b[37m\u001b[40m▒▒\u001b[99G\u001b(B\u001b[0;1m\u001b[37m\u001b[40mCo\u001b[2;1H\u001b(B\u001b[0m\u001b[37m\u001b[40m▒█\u001b[2;15H \u001b[30m\u001b[47m▒▒\u001b[2;30H\u001b[37m\u001b[40m █▒▒▒█\u001b[2;50H \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\u001b[59G▒▒▒▒▒▒▒\u001b(B\u001b[0;1m\u001b[33m\u001b[40m▒\u001b(B\u001b[0m\u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\r\u001b[3d▒█\u001b[3;15H \u001b[30m\u001b[47m▒▒\u001b[3;30H\u001b[37m\u001b[40m █▒▒▒█\u001b[3;50H \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█▒▒▒▒▒▒▒▒▒▒▒▒\u001b(B\u001b[0;1m\u001b[33m\u001b[40m▒\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\r\u001b[4d▒█   \u001b(B\u001b[0;1m\u001b[37m\u001b[42mE\u001b[4;15H\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[30m\u001b[47m▒▒\u001b[4;30H\u001b[37m\u001b[40m █▒▒▒█\u001b[4;50H \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█▒▒▒▒▒▒▒▒▒▒▒\u001b(B\u001b[0;1m\u001b[33m\u001b[40m▒\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\r\u001b[5d▒\u001b[5;28H█\u001b[30m\u001b[43m■■\u001b[37m\u001b[40m█▒▒▒█ \u001b[30m\u001b[43m■\u001b[5;49H\u001b[37m\u001b[40m█ \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█▒▒▒▒▒▒▒▒▒▒\u001b(B\u001b[0;1m\u001b[33m\u001b[40m█\u001b(B\u001b[0m\u001b[37m\u001b[40m██ \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\u001b[6;27H▒█\u001b[30m\u001b[43m■\u001b[37m\u001b[40m █▒▒▒█ \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\u001b[6;49H▒ \u001b[30m\u001b[43m■\u001b[37m\u001b[40m▒▒▒▒▒▒▒▒▒▒\u001b(B\u001b[0;1m\u001b[33m\u001b[40m▒\u001b(B\u001b[0m\u001b[37m\u001b[40m▒▒▒ \u001b[30m\u001b[43m■\u001b[7;27H\u001b[37m\u001b[40m▒█\u001b[30m\u001b[43m■\u001b[37m\u001b[40m █▒▒▒█ \u001b[30m\u001b[43m■\u001b[37m\u001b[40m█\u001b[7;49H▒ \u001b[30m\u001b[43m■\u001b[37m\u001b[40m▒▒▒▒▒▒▒▒▒\u001b(B\u001b[0;1m\u001b[33m\u001b[40m▒\u001b(B\u001b[0m\u001b[37m\u001b[40m▒▒▒▒ \u