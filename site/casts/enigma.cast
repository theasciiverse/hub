[0.001, "o", "\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[37m   \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[18;21H \u001b[11C\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[31mv\u001b[33m.\u001b[31mv\u001b[37m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[37m   \u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[19;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m  \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[31mvvv\u001b[33m.\u001b[37m\u001b[44m+\u001b[33m\u001b[40m\u001b[1m$$$$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[20;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m  \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m  \u001b[33m.\u001b[37m   \u001b[31mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[31mv\u001b[37m \u001b[31mv\u001b[33m:\u001b[31mv\u001b[37m  \u001b[31mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[1m$$$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[31mvvv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[21;21H            \u001b[36m\u001b[44m|\u001b[37m\u001b[40m   \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m----\u001b[37m+\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[33m.\u001b[37m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[31mv\u001b[33m.\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mvvvv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m      \u001b[22;33H\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m \u001b[31mv\u001b[37m    \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[6C.\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[31mv\u001b[37m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[33m.\u001b[31mv\u001b[36m\u001b[44m|\u001b[23;21H\u001b[37m\u001b[40m            \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m  \u001b[44m+\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[33m:\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[24;21H            \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m  \u001b[31mv\u001b[37m      \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m..\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m          \u001b[33m...\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[25;21H            \u001b[44m+\u001b[36m-\u001b[37m+\u001b[36m---------\u001b[37m+\u001b[36m-\u001b[37m+\u001b[36m---\u001b[37m+\u001b[36m-\u001b[37m+\u001b[36m--------------\u001b[37m+\u001b[40m            \u001b[26;21H            \u001b[36m1) \u001b[33mDarkness Falls\u001b[37m              \u001b[33m 0\u001b[36m/\u001b[33m61\u001b[37m            \u001b[H\u001b(B\u001b[m"]
