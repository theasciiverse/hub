[0.050539, "o", "\u001b[H\n\n\n\n\n\n\n\n\n         \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m^\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m                                          \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m^\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m                   \u001b[K\r\n         \u001b[38;5;34m \u001b[0m\u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m\u001b[38;5;34m \u001b[0m                                          \u001b[38;5;34m \u001b[0m\u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m\u001b[38;5;34m \u001b[0m                   \u001b[K\r\n         \u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m                                          \u001b[38;5;34m/\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m\\\u001b[0m                   \u001b[K\r\n         \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m|\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m                                          \u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m|\u001b[0m\u001b[38;5;34m \u001b[0m\u001b[38;5;34m \u001b[0m                   \u001b[K\r\n\n\n\n\n\n\n                                                                   \u001b[38;5;45m[\u001b[0m\u001b[38;5;45mA\u001b[0m\u001b[38;5;45m]\u001b[0m          \u001b[K\r\n\n\n        \u001b[1;38;5;226m \u001b[0m\u001b[1;38;5;226m(\u001b[0m\u001b[1;38;5;226mo\u001b[0m\u001b[1;38;5;226m>\u001b[0m\u001b[1;38;5;226m-\u001b[0m\u001b[1;38;5;226m-\u001b[0m\u001b[1;38;5;226m=\u001b[0m                                \u001b[1;38;5;201m \u001b[0m\u001b[1;38;5;201m_\u001b[0m\u001b[1;38;5;201m_\u001b[0m\u001b[1;38;5;201m_\u001b[0m\u001b[1;38;5;201m_\u001b[0m\u001b[1;38;5;201m \u001b[0m                           \u001b[K\r\n  