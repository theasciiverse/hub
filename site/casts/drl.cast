[0.023, "o", "\u001b[?12l\u001b[?25h\u001b[11;35H\u001b[31m\u001b[40m.\u001b[37m\u001b[40m..\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[12;33H\u001b(B\u001b[0m\u001b[31m\u001b[40m.\u001b[13;31H.\u001b[14d\b\b.\u001b[14;41H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m#\u001b(B\u001b[0m\u001b[37m\u001b[40m#\u001b(B\u001b[0;1m\u001b[30m\u001b[40m#\u001b[15;30H\u001b(B\u001b[0m\u001b[31m\u001b[40m.\u001b[15;43H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[16;29H\u001b(B\u001b[0m\u001b[31m\u001b[40m.\u001b[16;44H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[17;29H\u001b(B\u001b[0m\u001b[31m\u001b[40m.\u001b[17;44H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[18;28H\u001b(B\u001b[0m\u001b[31m\u001b[40m.\u001b[18;45H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[19;28H\u001b(B\u001b[0m\u001b[31m\u001b[40m.\u001b[36G\u001b[37m\u001b[40m@\u001b[31m\u001b[40m.\u001b[20;28H.\u001b[21d.\u001b[21;41H.\u001b[22;29H.\u001b[22;42H..\u001b[23;30H.\u001b[24d\b.\u001b[24;43H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[19;36H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
