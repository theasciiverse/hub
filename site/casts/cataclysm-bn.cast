[0.427, "o", "\u001b[H\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[1;24H\u001b(B\u001b[0;1m\u001b[33m\u001b[40m::\u001b[1;37H\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b[32m\u001b[40m.\r\u001b[2d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[2;38H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\r\u001b[3d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[3;34H\u001b[32m\u001b[40m............\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,,\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[32m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[30m\u001b[40mo\u001b(B\u001b[0m\u001b[33m\u001b[40m~\r\u001b[4d....\u001b[4;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b[4;36H\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,'\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.~o\r\u001b[5d......\u001b[32m\u001b[