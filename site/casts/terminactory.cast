[0.255, "o", "\u001b[1;62H\u001b[90m9\u001b[5;12H\u001b(B\u001b[m\u001b[38;5;250m\u001b[48;5;236m \u001b[9C\u001b[38;5;252m\u001b[48;5;238mgazette\u001b[Ccity  \u001b[6;12H\u001b[49m\u001b(B\u001b[m\u001b[38;5;117m━━━━━━\u001b[8;12H\u001b(B\u001b[m\u001b[38;5;229m\u001b[1mMunicipal Gazette — Y158-11-08, issue 412\u001b[9;33H\u001b(B\u001b[m    \u001b[C    \u001b[C    \u001b[C     \u001b[C     \u001b[C    \u001b[C    \u001b[10;12HThe\u001b[Ccity\u001b[Cpaper,\u001b[Cout\u001b[Cevery\u001b[Cmonth since Y124. Council notices,\u001b[Cplanning\u001b[11;12Happlications,\u001b[Cthe\u001b[Ccrossword, obituaries, letters, local sport\u001b[Cand\u001b[Cthe\u001b[Csmall\u001b[12;12Hads.\u001b[CRead\u001b[Cthe\u001b[Cfull\u001b[Carchive at \u001b[36m\u001b[4m\u001b[7mthe archive\u001b(B\u001b[m.     \u001b[C    \u001b[C    \u001b[14;12H\u001b[38;5;229m\u001b[1mCouncil: Mill Lane resurfacing postponed\u001b[15;12H\u001b(B\u001b[mThe\u001b[Ccouncil has agreed to postpone the Mill Lane resurfacing until after\u001b[Cthe\u001b[16;12Hwinter\u001b[Cfrosts. Harold Pimm\u001b[Creports\u001b[Cthe\u001b[Cwork\u001b[Cwas\u001b[Cdue\u001b[Cto\u001b[Cstart\u001b[Cthis\u001b[Cweek,\u001b[Cbut\u001b[17;12Hthe\u001b[Cgravel\u001b[Cdelivery is held up at the rail siding. New date to be confirmed\u001b[18;12Hat\u001b[Cthe\u001b[Cnext\u001b[Ccouncil\u001b[Csitting,\u001b[CY158-11-22.\u001b[CSee\u001b[C\u001b[36m\u001b[4mCouncil notes\u001b(B\u001b[m.\u001b[19;32H                \u001b[2C                   \u001b[20;12H\u001b[38;5;229m\u001b[1mPlanning: Ashgrove yard extension\u001b[21;12H\u001b(B\u001b[mAshgrove\u001b[CIronstone\u001b[Chas\u001b[Capplied\u001b[Cto\u001b[Cextend\u001b[Cits\u001b[Cscrap\u001b[Cyard\u001b[Conto\u001b[Cthe\u001b[Cvacant\u001b[Clot\u001b[22;12Hbehind the old weighing house. Objections close\u001b[CY158-11-18. Full\u001b[Capplication \u001b[23;12Hat\u001b[C\u001b[36m\u001b[4mPlanning applications\u001b(B\u001b[m.\u001b[25;12H\u001b[38;5;229m\u001b[1mIn memory: Moll Peck\u001b[26;13H\u001b(B\u001b[m\u001b[38;5;245m\u001b[48;5;236mgaz\u001b[Ct\u001b[Ce.city/archive\u001b[39m                    \u001b[38;5;252m\u001b[48;5;240m Copy page\u001b(B\u001b[m"]
