[0.605, "o", "\r\u001b[22d\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[2M\u001b[28d \u001b[90m\u001b[40mYou barely miss the ball python.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[90m\u001b[40mYour headbutt misses the ball python.\u001b[29;2H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40mThe ball python bites you but does no damage.\u001b[3;46H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m19\u001b[3;78H\u001b[31m\u001b[40m--\u001b[9;64H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m2.8 (1.4\u001b[1;38H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
