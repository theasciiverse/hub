                                    \u001b[19;1H                                                                                                    \u001b[20;1H                                                                                                    \u001b[21;1H                                                                                                    \u001b[22;1H                                                                                                    \u001b[23;1H                                                                                                    \u001b[24;1H                                                                                                    \u001b[25;1H                                                                                                    \u001b[26;1H                                                                                                    \u001b[27;1H                                                                                                    \u001b[28;1H                                                                                                    \u001b[29;1H                                                                                                    \u001b[30;1H                                                                                                    \u001b[1;1H                                                                                                    \u001b[2;1H                                                                                                    \u001b[3;1H                                                                                                    \u001b[4;1H                                                                                                    \u001b[5;1H                                                                                                    \u001b[6;1H                                                                                                    \u001b[7;1H                                                                                                    \u001b[8;1H                                                                                                    \u001b[9;1H                                                                                                    \u001b[10;1H                                                                                                    \u001b[11;1H                                                                                                    \u001b[12;1H                                                                                                    \u001b[13;1H                                                                                                    \u001b[14;1H                                                                                                    \u001b[15;1H                                                                                                    \u001b[16;1H                                                                                                    \u001b[17;1H                                                                                                    \u001b[18;1H                                                                                                    \u001b[19;1H                                                                                                    \u001b[20;1H                                                                                                    \u001b[21;1H                                                                                                    \u001b[22;1H                                                                                                    \u001b[23;1H                                                                                                    \u001b[24;1H                                                                                                    \u001b[25;1H                                                                                                    \u001b[26;1H                                                                                                    \u001b[27;1H                                                                                                    \u001b[28;1H                                                                                                    \u001b[29;1H                                                                                                    \u001b[30;1H                                                                                                    \u001b[8;41HBeyond the Titanic\u001b[9;41H\u001b[0;33;40m------------------\u001b[11;34H\u001b[0;37;40mA Text & Sound Adventure Fantasy\u001b[14;36HAn Apogee Software Production\u001b[18;31HWritten and Programmed by Scott Miller\u001b[26;42HPress any key..."]
[2.015, "o", "\u001b[?25l\u001b[1;1H                                                                                                    \u001b[2;1H                                                                                                    \u001b[3;1H                                                                                                    \u001b[4;1H                                                                                                    \u001b[5;1H                                                                                                    \u001b[6;1H                                                                                                    \u001b[7;1H                                                                                                    \u001b[8;1H                                                                                                    \u001b[9;1H                                                                                                    \u001b[10;1H                                                                                                    \u001b[11;1H                                                                                                    \u001b[12;1H                                                                                                    \u001b[13;1H                                                                                                    \u001b[14;1H                                                                                                    \u001b[15;1H                                                                                                    \u001b[16;1H                                                                                                    \u001b[17;1H                                                                                                    \u001b[18;1H                                                                                                    \u001b[19;1H                                                                                                    \u001b[20;1H                                                                                                    \u001b[21;1H                                                                                                    \u001b[22;1H                                                                                                    \u001b[23;1H                                                                                                    \u001b[24;1H                                                                                                    \u001b[25;1H                                                                                                    \u001b[26;1H                                                                                                    \u001b[27;1H                                                                                                    \u001b[28;1H                                                                                                    \u001b[29;1H                                                                                                    \u001b[30;1H                                                                                                    \u001b[1;1H\u001b[0;97;44m                                                                                                    \u001b[1;4HMove\u001b[1;10H0\u001b[1;88HScore\u001b[1;95H0\u001b[30;37H\u001b[0;93;40mAPRIL 14, 1912    11:43 PM\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;12HYou never knew the black canvas of the night was so full of twinkling detail.\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;14HStanding on deck of the White Star's new super luxury liner, deep at sea,\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;17Hwhere the bright lights of San Francisco don't fade the night, you\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                              "]
[0.000, "o", "                                                      \u001b[30;23Hcan view thousands of stars you never realized existed.\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;13HLooking out over the icy sea you can barely see small pieces of broken ice\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;17Hbobbing in the water.  Rumor has it that icebergs the size of small\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;23Hmountains can be found in this region.  You don't feel\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;25Htoo worried, though, the Titanic has been touted as\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;27H\"unsinkable,\" and every single passenger knows\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;29Hthat White Star, the premier ship builder,\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;40Hknows their stuff...\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;1H\u001b[0;92;40mShip's Fore\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;1H\u001b[0;96;40m  You are standing near the front of the Titanic on the starboard deck.  To the east a wooden rail f\u001b[30;100H \u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;1Hfollows the curve of the ship.  Behind you, to the south, are the sounds of a wild party.  A misty b\u001b[30;100H \u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;1Hbreeze parts your hair in an awkward place, and carries the message of an icy ocean.  As you gaze at\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[30;1Hthe stars you discover that the rail serves well as a place to lean on.\u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[2;30r\u001b[30;1H\u001bD\u001b[r\u001b[30;1H                                                                                                    \u001b[1;1H\u001b[0;97;44m                                                                                                    \u001b[1;4HMove\u001b[1;10H0\u001b[1;88HScore\u001b[1;95H0\u001b[1;40H     Ship's Fore     \u001b[30;1H\u001b[0;91;40;5m» \u001b[1;1H\u001b[0;97;44m                                                                                                    \u001b[1;4HMove\u001b[1;10H0\u001b[1;88HScore\u001b[1;95H0\u001b[1;40H     Ship's Fore     \u001b[30;3H\u001b[0;93;40m                                                                             \u001b[30;3H\u001b[?25h"]
