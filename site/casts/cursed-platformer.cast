[0.000, "o", "x\u000f\u001b[39;49m\u001b[37m\u001b[40m This is what we in the industry call \"a message\".    \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[12;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m    \u001b[12;46H"]
