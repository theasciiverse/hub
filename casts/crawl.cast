[0.606, "o", "\r\u001b[22d\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\u001b[2M\u001b[28d \u001b[90m\u001b[40mYou closely miss the ball python.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[90m\u001b[40mYour headbutt misses the ball python.\u001b[29;2H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40mThe ball python bites you but does no damage.\u001b[3;47H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m6\u001b[3;75H\u001b[31m\u001b[40m---\u001b[90m\u001b[40m--\u001b[9;64H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m5.6\u001b[1;38H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m\r\u001b[22d\u001b[M\u001b[29d_\u001b[91m\u001b[40mThe ball python constricts you.\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m The ball python bites you. \u001b[91m\u001b[40mThe ball python constricts you.\u001b[11;17H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
