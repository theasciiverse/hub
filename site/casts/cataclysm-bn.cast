[0.000, "o", "\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m',\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'f,7\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40m~#~\r\u001b[8d.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[8;14H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[8;26H\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[40G"]
