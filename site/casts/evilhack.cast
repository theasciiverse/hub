[0.002, "o", "\u001b[H\u001b[2J\u001b[H\u001b[H\u001b[2J\u001b[H\u001b[3;19H------\u001b[0m\u001b[3;41H----------------\u001b[0m\u001b[4;19H|..\u001b[0m\u001b[38;5;220m$\u001b[0m...\u001b[0m\u001b[4;41H\u001b[97mf@\u001b[0m......\u001b[0m\u001b[93m:\u001b[0m.....\u001b[0m\u001b[33m%\u001b[0m|\u001b[0m\u001b[5;19H|\u001b[0m\u001b[5;41H|........\u001b[0m\u001b[38;5;220m$\u001b[0m.....|\u001b[0m\u001b[6;41H----------------\u001b[0m\u001b[4;42H\u001b[23;1H\u001b[K\u001b[24;1H\u001b[K\u001b[AFreya the Stripling            St:18/02 Dx:12 Co:14 In:12 Wi:8 Ch:13 Lawful\u001b[K\r\u001b[24;1HDlvl:1 $:0 HP:19(19) Pw:2(2) AC:4 MC:0 TH:5 Xp:1 0m:00s\u001b[K\u001b[1;43H\u001b[K It is written in the Book of Tyr:\u001b[2;43H\u001b[K \u001b[3;43H\u001b[K     After the Creation, the cruel god Moloch rebelled\u001b[4;43H\u001b[K     against the authority of Marduk the Creator.\u001b[5;43H\u001b[K     Moloch stole from Marduk the most powerful of all\u001b[6;43H\u001b[K     the artifacts of the gods, the Amulet of Yendor,\u001b[7;43H\u001b[K     and he hid it in the dark cavities of Gehennom, the\u001b[8;43H\u001b[K     Under World, where he now lurks, and bides his time.\u001b[9;43H\u001b[K \u001b[10;43H\u001b[K Your god Tyr seeks to possess the Amulet, and with it\u001b[11;43H\u001b[K to gain deserved ascendance over the other gods.\u001b[12;43H\u001b[K \u001b[13;43H\u001b[K You, a newly trained Stripling, have been heralded\u001b[14;43H\u001b[K from birth as the instrument of Tyr.  You are destined\u001b[15;43H\u001b[K to recover the Amulet for your deity, or die in the\u001b[16;43H\u001b[K attempt.  Your hour of destiny has come.  For the sake\u001b[17;43H\u001b[K of us all:  Go bravely with Tyr!\u001b[18;43H\u001b[K\u001b[C--More--"]
[2.504, "o", "\u001b[1;42H\u001b[K\u001b[2;42H\u001b[K\u001b[3;42H\u001b[K---------------\u001b[4;42H\u001b[K\u001b[0m\u001b[97m@\u001b[0m......\u001b[0m\u001b[93m:\u001b[0m.....\u001b[0m\u001b[33m%\u001b[0m|\u001b[5;42H\u001b[K........\u001b[0m\u001b[38;5;220m$\u001b[0m.....|\u001b[6;42H\u001b[K---------------\u001b[7;42H\u001b[K\u001b[8;42H\u001b[K\u001b[9;42H\u001b[K\u001b[10;42H\u001b[K\u001b[11;42H\u001b[K\u001b[12;42H\u001b[K\u001b[13;42H\u001b[K\u001b[14;42H\u001b[K\u001b[15;42H\u001b[K\u001b[16;42H\u001b[K\u001b[17;42H\u001b[K\u001b[18;42H\u001b[K\u001b[0m"]
