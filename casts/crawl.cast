(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[36m\u001b[40m#\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \r\u001b[9d \u001b[90m\u001b[40m...\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     #.\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m...\u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m..\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \r\u001b[10d \u001b[90m\u001b[40m.#.#\u001b[10;14H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.#.\u001b[33m\u001b[40m#\u001b[90m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \r\u001b[11d\u001b[90m\u001b[40m#.#\u001b[11;12H\u001b[96m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[30m\u001b[47m@\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[33m\u001b[40m#\u001b[26G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[12;2H\u001b[90m\u001b[40m.#\u001b[12;16H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[33m\u001b[40m#\u001b[26G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \r\u001b[13d\u001b[90m\u001b[40m.#..#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m    #.\u001b[36m\u001b[40m###\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m..\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \r\u001b[14d\u001b[90m\u001b[40m.#\u001b[14;12H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m ......\u001b[96m\u001b[40m#\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \r\u001b[15d\u001b[90m\u001b[40m.#\u001b[15;11H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m #.\u001b[36m\u001b[40m###\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[96m\u001b[40m##\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m      \u001b[16;2H\u001b[90m\u001b[40m.\u001b[10G\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m ...  \u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m....      \u001b[17;2H\u001b[90m\u001b[40m.#\u001b[11G\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.   ...\u001b[33m\u001b[40m#\u001b[92m\u001b[40m:\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \r\u001b[18d\u001b[90m\u001b[40m.##\u001b[11G\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m    \u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m..\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m.\u001b[33m\u001b[40m#\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m     \r\u001b[19d\u001b[90m\u001b[40m.#\u001b[19;26H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \r\u001b[20d\u001b[90m\u001b[40m.#\u001b[20;26H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m \u001b[21d\b \u001b[9;45H"]
