[0.859, "o", "\u001b[17;16H\u001b[37m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40mP\u001b(B\u001b[0m\u001b[37m\u001b[40mreset Character             \u001b[18;16H\u001b[37m\u001b[44m» \u001b(B\u001b[0;1m\u001b[33m\u001b[44mR\u001b(B\u001b[0m\u001b[37m\u001b[44mandom Character             \u001b[26;7H\u001b(B\u001b[0;1m\u001b[33m\u001b[40mCreates random character, but lets you preview the generated character and the scenario\u001b[27;27Hand change character and/or scenario if needed.\u001b[22;47H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
