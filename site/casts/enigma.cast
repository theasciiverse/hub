[1.207, "o", "\u001b[9;37H\u001b[37m\u001b[40m  \u001b[31mv\u001b[33m.\u001b[37m\u001b[44m+\u001b[33m\u001b[40m.\u001b[37m        \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[33m.\u001b[37m \u001b[31mv\u001b[33m.\u001b[31mvv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[10;37H\u001b[37m \u001b[31mvv\u001b[37m           \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[37m \u001b[44m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[33m\u001b[40m..\u001b[37m\u001b[44m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+"]
[0.000, "o", "\u001b[11;37H\u001b(B\u001b[m\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m--\u001b[37m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b[12;37H\u001b(B\u001b[m\u001b[31m\u001b[40mv\u001b[37m    \u001b[31mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m--\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+"]
[0.001, "o", "\u001b[13;37H\u001b(B\u001b[m\u001b[36m\u001b[44m--\u001b[37m+\u001b[36m-\u001b[37m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[14;37H\u001b[37m  \u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[37m\u001b[40m   \u001b[31mv\u001b[37m  \u001b[31mv\u001b[33m..\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[33m\u001b[40m..\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[15;37H\u001b[40m  \u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m  \u001b[31mv\u001b[37m  \u001b[31mvvv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[6C \u001b[16;37H  \u001b[44m+\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m \u001b[31mv\u001b[37m\u001b[44m+\u001b[40m \u001b[44m+\u001b[31m\u001b[40mv\u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m     \u001b[31mv\u001b[37m    "]
[0.000, "o", "\u001b[17;37H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[31mv\u001b[37m  \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[18;37H\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[31mv\u001b[33m.\u001b[31mv\u001b[37m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[19;38H\u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[33m\u001b[40m.\u001b[31mvvv\u001b[33m.\u001b[37m\u001b[44m+\u001b[33m\u001b[40m\u001b[1m$\u001b[20;38H\u001b(B\u001b[m"]
[0.000, "o", "\u001b[37m\u001b[40m \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m \u001b[33m.\u001b[37m    \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[31mv\u001b[37m \u001b[31mv\u001b[33m:\u001b[31mv\u001b[37m  \u001b[31mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[1m$$$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[21;38H\u001b[31mv\u001b[37m\u001b[44m+\u001b[36m----\u001b[37m+\u001b[40m  \u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[33m.\u001b[37m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[31mv\u001b[33m.\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[22;37H\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m       \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[37m      \u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[31mv\u001b[37m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[H\u001b(B\u001b[m"]
