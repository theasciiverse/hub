[0.044, "o", "\u001b[1;9Hop exploring.   \u001b[2;9Hand at the door.\u001b[3;17H\u001b[37m\u001b[1m#\u001b[4;6H#\u001b[11C\u001b(B\u001b[m\u001b[37m,\u001b[5;5H,\u001b[8C¤\u001b[39m\u001b[40m,\u001b[3C\u001b[49m\u001b[37m,\u001b[6;4H\"\u001b[15C,\n,\u001b[8;4H\"\"\u001b[13C..\u001b[9;2H\"\"\"...\u001b[9C\"\u001b[10;2H\"......\u001b[33m☼\u001b[2C\u001b[40m.\u001b[2C\u001b[49m\u001b[37m,.\u001b[1m#\u001b[11;4H###\u001b(B\u001b[m\u001b[37m,.\u001b[C\u001b[1m#\u001b[C\u001b(B\u001b[m\u001b[34m\u001b[40m@\u001b[C\u001b[49m\u001b[37m...\u001b[1m#\u001b[12;11H\u001b[39m\u001b[40m#\u001b(B\u001b[m\u001b[40m.\u001b[33m.\u001b[39m\u001b[1m#\u001b[C\u001b(B\u001b[m\u001b[37m.\u001b[1m#\u001b[13;10H\u001b(B\u001b[m\u001b[37m¤\u001b[39m\u001b[40m....\u001b[49m\u001b[37m¤\u001b[14;10H¤\u001b[39m\u001b[40m..\u001b[32m♣\u001b[39m.\u001b[1m#\u001b[15;11H#\u001b(B\u001b[m\u001b[35m\u001b[40m+\u001b[39m\u001b[1m##\u001b[16;12H\u001b(B\u001b[m\u001b[37m¤\u001b[24;9H\u001b[39m3\u001b[42C\u001b[35m+ \u001b(B\u001b[m"]
