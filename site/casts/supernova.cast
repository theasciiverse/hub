[0.030, "o", "\u001b[29;2H\u001b[0;95;40mYour mouth feels a little dry.\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;95;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40mTwo weary, dusty alien miners enter the tavern and buy themselves a drink at the bar.  They look t\u001b[29;99H \u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40mthe place over then head toward the western table.  After slapping a cloud of dust off their pants\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40mthey both sit down.\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[0;92;40m\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[2;8H\u001b[0;93;41m4   \u001b[2;42H      Tavern      \u001b[2;95H    \u001b[2;95H15 \u001b[3;22H\u001b[0;34;47m  *    \u001b[3;33H\u001b[0;97;47m *    \u001b[3;43H\u001b[0;31;47m *  \u001b[3;51H\u001b[0;30;47m   *   \u001b[3;62H\u001b[0;33;47m  *  \u001b[3;71H\u001b[0;35;47;5mThirsty\u001b[0;91;40;5m\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;91;40;5m                                                                                                  \u001b[0;37;44m│\u001b[28;2H\u001b[0;91;40;5m»\u001b[28;4H\u001b[0;93;40m\u001b[?25h"]
