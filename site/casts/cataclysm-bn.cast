[0.398, "o", "\u001b[H\u001b[C\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[10G\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[1;33H\u001b(B\u001b[0m\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m',#\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[33m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[42m#\u001b[2;4H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[2;20H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[2;32H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[30m\u001b[40m0\r\u001b[3d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[3;19H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[3;31H\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b(B\u001b[0m\u001b[32m\u001b[40m#\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40m.\r\u001b[4d\u001b[32m\u001b[40m......\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[4;18H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[4;30H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[4;42H\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,,\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[32m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[30m\u001b[40mo\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b(B\u001b[0m\u001b[33m\u001b[40m~\u001b[5;6H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[5;29H"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,'\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m..\u001b[34m\u001b[40m~\u001b[30m\u001b[40mo\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40mi\u001b[30m\u001b[40m \u001b[6;4H\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[6;16H\u001b[33m\u001b[40m::\u001b[30m\u001b[40m.\u001b[6;28H"]
