[0.101, "o", "\r\u001b[4d\u001b(B\u001b[0;1m\u001b[32m\u001b[40m \\\r\u001b[5d__ >\u001b[11d\b\b\u001b[36m\u001b[40mo\r\u001b[12d\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[K\u001b[17;4H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m.\u001b[18;61H\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[1K\u001b[23d\b\b\u001b[32m\u001b[40m/\u001b[37m\u001b[40m      \u001b(B\u001b[0;1m\u001b[33m\u001b[40m,\u001b(B\u001b[0m\u001b[36m\u001b[40m/\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b[30m\u001b[40m \u001b[24;55H\u001b[36m\u001b[40m,..\u001b(B\u001b[0m\u001b[32m\u001b[40m/\u001b(B\u001b[0;1m\u001b[36m\u001b[40m...\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b(B\u001b[0;1m\u001b[33m\u001b[40m<\u001b[37m\u001b[40m'\u001b[36m\u001b[40m)\u001b(B\u001b[0m\u001b[37m\u001b[40m   \u001b(B\u001b[0;1m\u001b[33m\u001b[40m`\u001b[36m\u001b[40m=<\u001b[30m\u001b[40m_\u001b[25;54H\u001b[36m\u001b[40m/\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[62G\u001b(B\u001b[0;1m\u001b[36m\u001b[40m'\\\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b[35m\u001b[40m/\u001b[31m\u001b[40m\\\u001b(B\u001b[0;1m\u001b[33m\u001b[40m```\u001b[30m\u001b[40m \u001b[26;53H\u001b[32m\u001b[40m<\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[37m\u001b[40m'\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b(B\u001b[0;1m\u001b[31m\u001b[40m)\u001b(B\u001b[0m\u001b[37m\u001b[40m     \u001b[35m\u001b[40m=<\u001b[37m\u001b[40m \u001b[27;54H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\\\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[36m\u001b[40m\\\u001b(B\u001b[0m\u001b[37m\u001b[40m      \u001b(B\u001b[0;1m\u001b[36m\u001b[40m/\u001b(B\u001b[0m\u001b[37m\u001b[40m  \u001b[35m\u001b[40m\\\u001b[37m\u001b[40m \u001b[28;55H\u001b(B\u001b[0;1m\u001b[36m\u001b[40m`'\\'\"'\"'\u001b(B\u001b[0m\u001b[37m\u001b[40m     \u001b[32m\u001b[40m(\u001b(B\u001b[0;1m\u001b[30m\u001b[40m \u001b[29d\b\b\u001b(B\u001b[0m\u001b[32m\u001b[40m )\u001b[30d\b\b(\u001b(B\u001b[0;1m\u001b[30m\u001b[40m \u001b[100G\u001b(B\u001b[m\u001b[39;