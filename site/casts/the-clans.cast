[0.0, "o", "\u001b[37m"]
[0.805, "o", "Yes\n\r\u001b[2J\u001b[1;1H"]
[0.0, "o", "\u001b[0;37;40m\u001b[1;35m"]
[0.0, "o", "Creating clansman 1 of 4\n"]
[0.0, "o", "\r"]
[0.0, "o", "\n\r"]
[0.001, "o", " \u001b[34mThe Clan Leader\n\r"]
[0.001, "o", "\n\r"]
[0.001, "o", " \u001b[0;36;40mThe first clan member you choose is important.  He will be thought of as the\n\r"]
[0.002, "o", " \"Clan Leader\" and have superior stats when compared with the other members.\n\r"]
[0.001, "o", " This member can be thought of as \"you\".  When the game addresses your\n\r"]
[0.001, "o", " character, it will assume this character.  Be sure to choose wisely for this\n\r"]
[0.001, "o", " character!\n\r\n"]
[0.0, "o", "\r"]
