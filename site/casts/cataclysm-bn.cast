[0.393, "o", "\u001b[H\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[11G\u001b[32m\u001b[40m.\u001b[1;34H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m',#\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[33m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\r\u001b[2d\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[2;21H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[2;33H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\r\u001b[3d.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[3;20H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[3;32H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[34m\u001b[40m~\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b(B\u001b[0m\u001b[32m\u001b[40m#\r\u001b[4d.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[4;19H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[4;31H\u001b[30m\u001b[40m.\u001b[4;43H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,,\u001b[33m\u001b[40mi\u001b(B\u001b[0;1m\u001b[32m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[30m\u001b[40mo\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[5;7H.\u001b[5;30H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m...\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,'\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m..\u001b[34m\u001b[40m~\u001b[30m\u001b[40mo\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40mi\u001b[6;5H\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[6;17H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[6;29H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[43G\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[31m\u001b[40mf\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[30m\u001b[42m#\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~~\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[30m\u001b[40m  \u001b[33m\u001b[40mo\r\u001b[7d.\u001b[32m\u001b[40m....\u001b[7;16H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[7;28H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[32m\u001b[40m',\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m'f,7\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[34m\u001b[40m~~\u001b[8;2H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[8;15H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[8;27H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[41G\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m...\u001b[32m\u001b[40m,,,\u001b[33m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m#\u001b(B\u001b[0m\u001b[33m\u001b[40m,#,\u001b[9;3H\u001b[32m\u001b[40m.\u001b[9;26H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m..\u001b[35G\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[43G\u001b[32m\u001b[40m.,,\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,,,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m,.\u001b[30m\u001b[40m  \u001b[33m\u001b[40m,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[10;2H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[10;13H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[10;25H\u001b[30m\u001b[40m.\u001b[10;37H\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m..\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40m~\u001b[30m\u001b[40m   \u001b(B\u001b[0;1m\u001b[32m\u001b[40m.#\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[34m\u001b[40m~\u001b[32m\u001b[40m,\r\u001b[11d.\u001b[11;12H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[11;24H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[42G\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m7\u001b(B\u001b[0m\u001b[30m\u001b[40m \u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b[32m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[34m\u001b[40m~\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[12;11H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[12;23H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[12;41H\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m..\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[33m\u001b[40mf\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b(B\u001b[0;1m\u001b[32m\u001b[40m7\u001b[13;22H\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[32m\u001b[40m......\u001b[33m\u001b[40m..\u001b(B\u001b[0;1m\u001b[32m\u001b[40m.\u001b[34m\u001b[42m#\u001b(B\u001b[0m\u001b[32m\u001b[40m,\u001b[33m\u001b[40m,\u001b[13;70H\u001b[37m\u001b[40m40\u001b[14;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[33m\u001b[40m::\u001b[14;21H"]
