[0.314, "o", "\u001b[2;21H\u001b[37m\u001b[40m \u001b[14C\u001b[33m\u001b[1m#\u001b[3;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[3C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[C\u001b[33m\u001b[1mV\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[6C\u001b[33m\u001b[1m#\u001b[4;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#%#\u001b(B\u001b[m\u001b[37m\u001b[40mE_=\u001b[33m\u001b[1m#\u001b[5;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#+#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[6;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[4C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[7;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#M\u001b[2C#\u001b[8;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[9C\u001b[34m.\u001b[3C.\u001b[33m\u001b[1m#\u001b[9;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[13C\u001b[34m.\u001b[33m\u001b[1m#\u001b[10;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[13C\u001b[34m.\u001b[33m\u001b[1m#\u001b[11;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#+\u001b[2C#\u001b[12;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#\u001b[13;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m+\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[14;21H\u001b(B\u001b[m\u001b[37m\u001b[40m \u0