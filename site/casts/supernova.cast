[0.001, "o", "\u001b[28;2H\u001b[0;35;40m»\u001b[29;2H\u001b[0;96;40mYou lean toward the aliens to hear what they are discussing.\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;96;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40mFirst Alien:  This mining work is for the drazils.\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40mSecond Alien: Yea, but guess what I overheard today in the mine. This may\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40m              just be the break we've been looking for.\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[29;2H\u001b[0;92;40mThe bartender is busy cleaning the top of the bar.\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[0;92;40m\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;92;40m                                                                                                  \u001b[0;37;44m│\u001b[2;8H\u001b[0;93;41m6   \u001b[2;42H      Tavern      \u001b[2;95H    \u001b[2;95H35 \u001b[3;22H\u001b[0;34;47m  *    \u001b[3;33H\u001b[0;97;47m *    \u001b[3;43H\u001b[0;31;47m *  \u001b[3;51H\u001b[0;30;47m   *   \u001b[3;62H\u001b[0;33;47m  *  \u001b[3;71H\u001b[0;35;47;5mThirsty\u001b[0;91;40;5m\u001b[5;29r\u001b[29;1H\u001bD\u001b[r\u001b[29;1H\u001b[0;37;44m│\u001b[0;91;40;5m                                                                                                  \u001b[0;37;44m│\u001b[28;2H\u001b[0;91;40;5m»\u001b[28;4H\u001b[0;93;40m\u001b[?25h"]
