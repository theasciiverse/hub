[0.0, "o", "\r"]
[0.002, "o", "\n\r"]
[0.001, "o", " \u001b[1;34mHealing "]
[0.0, "o", "\u001b[0;36;40m"]
[0.0, "o", "is done automatically after combat where necessary.  However,"]
[0.0, "o", "\n"]
[0.0, "o", "\r"]
[0.001, "o", "   mana (MP) is not restored but is restored automatically as combat\n\r"]
[0.001, "o", "   progresses.\n\r"]
[0.001, "o", "\n\r"]
[0.001, "o", " \u001b[1;34mDying \u001b[0;36;40m"]
[0.0, "o", "is very real in combat!  There are three HP thresholds to know:"]
[0.0, "o", "\n"]
[0.0, "o", "\r"]
[0.001, "o", "   Below   0 HP: knocked out -- unconscious, recovers the next day.\n\r"]
[0.001, "o", "   Below  -5 HP: mortal wound -- unconscious and MaxHP is permanently reduced.\n\r"]
[0.001, "o", "   Below -15 HP: dead -- cannot play until resurrected.\n\r"]
[0.001, "o", "\n\r\u001b[1;30m<"]
