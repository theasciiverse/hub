[0.001, "o", "\u001b[5;21H\u001b[37m\u001b[40m                          \u001b[36m\u001b[44m\u001b[1m Enigma \u001b(B\u001b[m\u001b[37m\u001b[40m                          \u001b[6;21H            \u001b[44m+\u001b[36m--\u001b[37m+\u001b[36m----\u001b[37m+\u001b[36m-------------\u001b[37m+\u001b[36m----------\u001b[37m+\u001b[36m-\u001b[37m+\u001b[40m            \u001b[7;21H\u001b(B\u001b[m\u001b[37m\u001b[40m            \u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[31m\u001b[40mvv\u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m           \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[37m \u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[37m   \u001b[31mv\u001b[37m E\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[8;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvvvv\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-------\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[33m.\u001b[37m \u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[31mv\u001b[37m \u001b[31mvv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m            \u001b[9;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[31mv\u001b[37m\u001b[44m+\u001b[33m\u001b[40m....\u001b[37m\u001b[44m+\u001b[33m\u001b[40m.\u001b[37m \u001b[31mv\u001b[37m \u001b[31mv\u001b[37m \u001b[31mv\u001b[37m  \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[31m\u001b[40mvv\u001b[33m.\u001b[37m \u001b[31mv\u001b[33m.\u001b[31mvv\u001b[33m.\u001b[31mv\u001b[33m..\u001b[31mvv\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[10;21H "]
[0.001, "o", "\u001b[11C\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[33m.\u001b[7C\u001b[31mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[33m.\u001b[31mv\u001b[37m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[33m\u001b[40m.\u001b[37m \u001b[44m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[33m\u001b[40m..\u001b[37m\u001b[44m+\u001b[33m\u001b[40m.\u001b[37m\u001b[44m+\u001b[40m \u001b[33m.\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m            \u001b[11;21H \u001b[11C\u001b[36m\u001b[44m|\u001b[37m\u001b[40m  \u001b[44m+\u001b[40m \u001b[44m+\u001b[36m--\u001b[37m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[44m+\u001b[40m \u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[12;21H\u001b[37m\u001b[40m \u001b[11C\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[37m\u001b[40m     \u001b[33m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[31m\u001b[40mv\u001b[36m\u001b[44m|\u001b[33m\u001b[40m\u001b[1m$\u001b(B\u001b[m\u001b[36m\u001b[44m|\u001b[33m\u001b[40m.\u001b[36m\u001b[44m|\u001b[37m\u001b[40m \u001b[44m+\u001b[36m-\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m--\u001b[37m+\u001b[31m\u001b[40mv\u001b[37m\u001b[44m+\u001b[36m-\u001b[37m+\u001b[40m \u001b[36m\u001b[44m|\u001