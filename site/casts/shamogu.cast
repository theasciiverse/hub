[0.080, "o", "\u001b[1;2H\u001b[32m You charge the berserking spider (1 dmg).\u001b[31m The berserking spider hits you (1\r\ndmg).\u001b[C\u001b[39m   \u001b[C \u001b[C          \u001b[C       \u001b[C   \u001b[C    \u001b[C \u001b[C         \u001b[3;21H\u001b[37m.......\u001b[C.......\u001b[4;26H\"\u001b[3C\"\u001b[5;26H\u001b[39m\u001b[40m\"\u001b[C\u001b[31m@\u001b[C\u001b[39m\"\u001b[49m\u001b[37m¤\u001b[6;27H\u001b[39m\u001b[40m\"\u001b[91ms\u001b[39m\"\u001b[C\u001b[49m\u001b[36m♫\u001b[37m♫\u001b[7;28H\u001b[39m\u001b[40m\u001b[1m#\u001b(B\u001b[m\u001b[37m¤\u001b[24;20H\u001b[32m8\u001b(B\u001b[m"]
[0.081, "o", "\u001b[H\u001b[31mThe berserking spider hits you (1 dmg).\u001b[33m You’re berserk (4 turns).\u001b[39m You feel   \r\nbetter\u001b[C(+6\u001b[CHP).\u001b[5;28H\u001b[32m\u001b[40m@\u001b[24;21H\u001b[49m+6/15\u001b[39m A:\u001b[34m4\u001b[39m D:1\u001b[C\u001b[34mBer(4)\u001b[C\u001b[39m\""]
[0.060, "o", "\u001b[H\u001b[33mYou’re berserk (4 turns).\u001b[39m You feel better (+6 HP). You see a hungry rat. You\r\nh\u001b[Car the flapping\u001b[Cof\u001b[Cwings.\u001b[3B\u001b[34m\u001b[40m@\n\u001b[31mr\u001b[49m\u001b[37m♫\u001b[24;1H\u001b[39m L:1 T:1\u001b[C6 [M] \u001b[34m↓\u001b[39m HP:\u001b[32m8+6/15\u001b[39m A:\u001b[34m4\u001b[39m D:1 \u001b[34mBer(4)\u001b[39m \""]
[0.284, "o", "\u001b[HYou feel better (+6 HP). You se\u001b[C a\u001b[Chungry\u001b[Crat. You\u001b[Chear the flapping of wings.\r\n•\u001b[32m You kill the berserking spider (2 dmg).\u001b[6;28H\u001b[36m\u001b[40m∞\u001b[24;1H\u001b[39m\u001b[49mL:1 T:156 [M] \u001b[34m↓\u001b[39m HP:\u001b[32m8+6/15\u001b[39m A:\u001b[34m4\u001b[39m D:1 \u001b[34mBer(4)\u001b[39m \" "]
