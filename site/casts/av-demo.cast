70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mwhite smoke into the night sky.                                                                     \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[20;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;217;71;79;48;2;10;12;14m\u00bb\u001b[0;38;2;255;107;107;48;2;10;12;14m \u001b[0;38;2;255;200;87;48;2;10;12;14mexamine lifeboats                                                            \u001b[0;38;2;111;224;212;48;2;10;12;14m                     \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[21;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mYou see nothing special about the boat.\u001b[0;38;2;255;200;87;48;2;10;12;14m                                                             \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[22;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mA bright yellow shooting star streaks across the blackness and fades away.                          \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[23;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;217;71;79;48;2;10;12;14m\u00bb\u001b[0;38;2;255;107;107;48;2;10;12;14m \u001b[0;38;2;255;200;87;48;2;10;12;14mn                                                                            \u001b[0;38;2;111;224;212;48;2;10;12;14m                     \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[24;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;123;220;98;48;2;10;12;14mLife Boat\u001b[0;38;2;255;200;87;48;2;10;12;14m                                                                                           \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[25;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14m  You are within one of the many wooden lifeboats along this side of the ship.  A single thick rope \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[26;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14msecures the boat to the Titanic.  You can still walk across the steps to the south to get back onto \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[27;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mthe great ship.  A small red kit is built into the side of the boat, just beside the first bench.   \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[28;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14m                                                                                                    \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[29;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mKKLLAAAAABBLLAAAANNGGGG!!!!!...The Titantic lurches sideways as a teeth-grinding sound rips across  \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[30;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mthe side of the ship.  You suddenly realize that the ship has struck an iceburg!  Even as you think \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[31;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mthe huge vessal tilts and studders, sinking lower and lower into the icy black ocean.  Crowds of    \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[32;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;111;224;212;48;2;10;12;14mpeople rush from every exit in a mad panic to escape the danger.                                    \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[33;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[0;38;2;255;107;107;48;2;10;12;14m\u00bb \u001b[0;38;2;255;200;87;48;2;10;12;14m                                                                             \u001b[0;38;2;111;224;212;48;2;10;12;14m                     \u001b[0;38;2;46;57;70;48;2;16;21;27m\u2502\u001b[34;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[35;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;1;38;2;255;176;0;48;2;16;21;27mBeyond the Titanic\u001b[0;39;48;2;16;21;27m                                      \u001b[0;38;2;127;220;94;48;2;29;37;48m   Install    \u001b[0;39;48;2;16;21;27m  \u001b[0;38;2;91;101;112;48;2;29;37;48m     Play     \u001b[0;39;48;2;16;21;27m  \u001b[0;38;2;127;220;94;48;2;29;37;48m  \u2661 Wishlist  \u001b[36;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;138;148;158;48;2;16;21;27mApril 1912, and the unsinkable ship has just hit the iceberg. Surviving the night is only the start of\u001b[37;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;138;148;158;48;2;16;21;27ma journey through caverns under the sea, a buried alien saucer and a ruined future, all the way home.\u001b[0;39;48;2;16;21;27m \u001b[38;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;188;196;204;48;2;16;21;27m                        \u001b[0;38;2;95;191;69;48;2;16;21;27m\u2502\u001b[0;38;2;46;57;70;48;2;16;21;27m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[39;1H\u001b[0;38;2;95;191;69;48;2;16;21;27m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0;38;2;91;101;112;48;2;16;21;27mDeveloper  \u001b[0;38;2;188;196;204;48;2;16;21;27mScott Miller\u001b[0;39;48;2;16;21;27m                                                                       \u001b[0;38;2;255;176;0;48;2;29;37;48m \u2193 more \u001b[40;1H\u001b[0;38;2;233;194;122;48;2;16;21;27m 395 titles \u001b[0;38;2;91;101;112;48;2;16;21;27m\u2191\u2193 select  \u2191 at the top: what to show  / or type to search  Enter actions  Tab panels  F1 help  Esc quit\u001b[0;38;2;188;196;204;48;2;16;21;27m            \u001b[0m"]
