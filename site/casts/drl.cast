[0.000, "o", "\u001b(B\u001b[0;1m\u001b[31m\u001b[40m \u001b(B\u001b[0m\u001b[34m\u001b[40m----\u001b(B\u001b[0;1m\u001b[31m\u001b[40m Settings \u001b(B\u001b[0m\u001b[34m\u001b[40m------\u001b[37m\u001b[40m\u001b[16X\u001b[22;13H\u001b[27X\u001b[22;40H\u001b(B\u001b[0;1m\u001b[31m\u001b[40m \u001b[34m\u001b[40m=\u001b[37m\u001b[40m Buy JHC on Steam!\u001b[34m\u001b[40m=\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[7b\u001b[23;13H\u001b[27X\u001b[23;40H\u001b(B\u001b[0;1m\u001b[31m\u001b[40m \u001b(B\u001b[0m\u001b[34m\u001b[40m------\u001b(B\u001b[0;1m\u001b[31m\u001b[40m Exit \u001b(B\u001b[0m\u001b[34m\u001b[40m-\u001b[7b\u001b[37m\u001b[40m\u001b[18X\u001b[24;13H\u001b[76X\u001b[25d  \u001b[26d\b\b\u001b[70X\u001b[27d\u001b(B\u001b[0;1m\u001b[34m\u001b[40mSupport the game by buying the \u001b[37m\u001b[40mDRL expansion\u001b[34m\u001b[40m at \u001b[37m\u001b[40mjupiterhellclassic.com\u001b[34m\u001b[40m!\u001b[3;11H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[1.009, "o", "\u001b[17;40H\u001b[37m\u001b[40m\u001b[21X\u001b[18d\u001b[21X\u001b[19;21H\u001b(B\u001b[0;1m\u001b[33m\u001b[40mRegular game\u001b[40G\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b(B\u001b[0;1m\u001b[31m\u001b[40m- \u001b[33m\u001b[40mRegular game \u001b[31m\u001b[40m-\u001b[29b\u001b[20;21HChallenge game\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[26X\u001b[21;21H\u001b(B\u001b[0;1m\u001b[31m\u001b[40mSeeded game\u001b[21;40H"]
[0.000, "o", "\u001b(B\u001b[0m\u001b[37m\u001b[40m Start a standard game with the normal rules.\u001b[22;40H\u001b[21X\u001b[23d\u001b[21X\u001b[27;13H\u001b[71X\u001b[3;11H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
[1.012, "o", "\u001b[19;21H\u001b[37m\u001b[40m \u001b[11b\u001b[19;41H\u001b(B\u001b[0;1m\u001b[33m\u001b[40mI'm Too Young To Die!\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[24X\u001b[20;21H\u001b[14X\u001b[20;41H\u001b(B\u001b[0;1m\u001b[31m\u001b[40mHey, Not Too Rough\u001b[21;21H\u001b(B\u001b[0m\u001b[37m\u001b[40m \u001b[10b\u001b[21;41H\u001b(B\u001b[0;1m\u001b[31m\u001b[40mHurt Me Plenty\u001b(B\u001b[0m\u001b[37m\u001b[40m\u001b[30X\u001b[22;41H\u001b(B\u001b[0;1m\u001b[30m\u001b[40mUltra-Violence\u001b[23;41HNightmare!\u001b[3;11H\u001b(B\u001b[m\u001b[39;49m\u001b[37m\u001b[40m"]
