[0.000, "o", "\u001b[36m\u001b[40m\"\"\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\u001b(B\u001b[0m\u001b[36m\u001b[40m\"\"\"\u001b[34m\u001b[40m=\u001b[24b\u001b[36m\u001b[40m7\u001b[34m\u001b[40m======\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[34m\u001b[40m=\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m..7777\u001b[36m\u001b[40m77\u001b[32m\u001b[40m.\u001b[36m\u001b[40m7\u001b[33m\u001b[40m###\u001b[34m\u001b[40m===\u001b(B\u001b[0;1m\u001b[32m\u001b[40mo\u001b(0\u001b[0m\u001b[37m\u001b[41mlqwq\u001b(B\u001b[0m\u001b[34m\u001b[40m======\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[34m\u001b[40m=\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[34m\u001b[40m=\u001b[6b\r\u001b[16d"]
[0.000, "o", "\u001b[36m\u001b[40m\"\"\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\u001b(B\u001b[0m\u001b[36m\u001b[40m\"\"\"\"\"\"\u001b[34m\u001b[40m=\u001b[18b\u001b[36m\u001b[40m7\u001b[34m\u001b[40m==\u001b[36m\u001b[40m7\u001b[34m\u001b[40m=====\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[30m\u001b[43m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m...\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(B\u001b[0m\u001b[32m\u001b[40m77777\u001b[33m\u001b[40m####\u001b[34m\u001b[40m==\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(B\u001b[0m\u001b[34m\u001b[40m=====\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[34m\u001b[40m======\r\u001b[17d"]
[0.000, "o", "\u001b[36m\u001b[40m\"\"\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\u001b(B\u001b[0m\u001b[36m\u001b[40m\"o\"\"\"\"\"\u001b[34m\u001b[40m=\u001b[13b\u001b[36m\u001b[40m7\u001b[34m\u001b[40m===\u001b[36m\u001b[40m7777\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0m\u001b[32m\u001b[40m77\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(B\u001b[0m\u001b[34m\u001b[41mo\u001b[32m\u001b[40m7o\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b[32m\u001b[40mo\u001b[32m\u001b[41moo\u001b[35m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mlwu\u001b(B\u001b[0;1m\u001b[32m\u001b[40mo\u001b[32m\u001b[41mo\u001b(B\u001b[0m\u001b[34m\u001b[40m====\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[34m\u001b[40m=\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[34m\u001b[40m=====\r\u001b[18d"]
[0.000, "o", "\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\"\"\u001b(B\u001b[0m\u001b[36m\u001b[40m\"\u001b[6b\u001b[34m\u001b[40m=\u001b[13b\u001b[36m\u001b[40m777\u001b[34m\u001b[40m=\u001b[36m\u001b[40m7\u001b[32m\u001b[40m.\u001b[36m\u001b[40m7\u001b[32m\u001b[40m...\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[34m\u001b[40m==\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[32m\u001b[40m....\u001b(0\u001b[0m\u001b[37m\u001b[41mmqq\u001b[37m\u001b[40mq\u001b[37m\u001b[41mqk\u001b(B\u001b[0m\u001b[32m\u001b[40m7\u001b(0\u001b[0m\u001b[37m\u001b[40mq\u001b[37m\u001b[41mq\u001b[37m\u001b[40mq\u001b[37m\u001b[41mwwnvj\u001b(B\u001b[0m\u001b[34m\u001b[40m===\u001b(B\u001b[0;1m\u001b[33m\u001b[40m......\u001b(B\u001b[0m\u001b[32m\u001b[40m.....\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[34m\u001b[40m=====\r\u001b[19d"]
[0.000, "o", "\u001b[36m\u001b[40m\"\"\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\"\u001b(B\u001b[0m\u001b[36m\u001b[40m\"\u001b[6b\u001b[34m\u001b[40m=\u001b[14b\u001b[36m\u001b[40m777777\"\u001b[32m\u001b[40m..\u001b(B\u001b[0;1m\u001b[33m\u001b[40m..\u001b(B\u001b[0m\u001b[34m\u001b[40m===\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mlq\u001b(B\u001b[0m\u001b[32m\u001b[41moO\u001b(B\u001b[0;1m\u001b[31m\u001b[41m&\u001b[32m\u001b[41mo\u001b(B\u001b[0m\u001b[32m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b[34m\u001b[41mo\u001b[32m\u001b[41mo\u001b(B\u001b[0m\u001b[34m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mt\u001b[37m\u001b[40mv\u001b[37m\u001b[41mu\u001b(B\u001b[0;1m\u001b[32m\u001b[41moo\u001b(B\u001b[0m\u001b[34m\u001b[40m===\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[32m\u001b[40m......\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.....\u001b(B\u001b[0m\u001b[34m\u001b[40m=====\r\u001b[20d"]
[0.000, "o", "\u001b[36m\u001b[40m\"\"\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m\"\"\"\"\u001b[34m\u001b[40m==\u001b[36m\u001b[40m\"\u001b[34m\u001b[40m=\u001b[14b\u001b[36m\u001b[40m7\u001b[6b\u001b(B\u001b[0;1m\u001b[32m\u001b[40m\"\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[36m\u001b[40m\"\u001b[32m\u001b[40m.\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b(B\u001b[0m\u001b[34m\u001b[40m===\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[36m\u001b[41mo\u001b[34m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0m\u001b[34m\u001b[41mo\u001b[36m\u001b[41mo\u001b[30m\u001b[41mo\u001b(B\u001b[0;1m\u001b[31m\u001b[40m&\u001b[34m\u001b[41mo\u001b(B\u001b[0m\u001b[33m\u001b[41mO\u001b(0\u001b[0m\u001b[37m\u001b[40mt\u001b[37m\u001b[41mwwwwu\u001b(B\u001b[0;1m\u001b[32m\u001b[40mo\u001b(0\u001b[0m\u001b[37m\u001b[40mx\u001b(B\u001b[0;1m\u001b[32m\u001b[41mo\u001b(0\u001b[0m\u001b[37m\u001b[41mx\u001b(B\u001b[0m\u001b[34m\u001b[40m====\u001b[32m\u001b[40m....\u001b(B\u001b[0;1m\u001b[33m\u001b[40m...\u001b(B\u001b[0m\u001b[34m\u001b[40m=\u001b[8b\r\u001b[21d"]
