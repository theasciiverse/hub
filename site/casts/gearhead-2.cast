[0.004, "o", "\u001b[2;17H\u001b[37m\u001b[40m \u001b[14C\u001b[33m\u001b[1m#\u001b[3;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[6C\u001b[33m\u001b[1m#\u001b[24C\u001b(B\u001b[m\u001b[36m\u001b[40mG\u001b[4;17H\u001b[37m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#%#\u001b(B\u001b[m\u001b[37m\u001b[40mE_=\u001b[33m\u001b[1m#\u001b[24C\u001b[30mS\u001b[5;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#+#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[6;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[4C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[7;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#-\u001b[2C#\u001b[8;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[9C\u001b[34m.\u001b[33m\u001b[1mM\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[9;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[13C\u001b[34m.\u001b[33m\u001b[1m#\u001b[10;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[13C\u001b[34m.\u001b[33m\u001b[1m#\u001b[11;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#+\u001b[2C#\u001b[12;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[2C\u001b[33m\u001b[1m#\u001b[13;17H\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m\u001b[1m#\u001b[6C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[2C\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m+\u001b(B\u001b[m\u001b[34m\u001b[40m.\u001b[33m\u001b[1m#\u001b[14;17H\u001b(