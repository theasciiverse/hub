[0.000, "o", "\u001b[30m\u001b[40m.\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[37m\u001b[40m...\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m   \u001b[34m\u001b[40m%\u001b[4;14H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[37m\u001b[40m...#\u001b[30m\u001b[40m  \u001b[36m\u001b[40m.\u001b[5;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m.\u001b[5;14H.\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m...\u001b[37m\u001b[40m...\u001b[33m\u001b[40m+\u001b[30m\u001b[40m \u001b[36m\u001b[40m.\u001b[6;3H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m...\u001b[33m\u001b[40m.\u001b[30m\u001b[40m.\u001b[7b\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[33m\u001b[40m....\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[37m\u001b[40m...#\u001b[36m\u001b[40m.\u001b[30m\u001b[40m   \r\u001b[7d\u001b(B\u001b[0;1m\u001b[33m\u001b[40m.\u001b[30m\u001b[40m..\u001b[33m\u001b[40m..\u001b[30m\u001b[40m....\u001b(B\u001b[0m\u001b[37m\u001b[40m%\u001b(B\u001b[0;1m\u001b[30m\u001b[40m...\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m....\u001b[33m\u001b[40m..\u001b[37m\u001b[40m...\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[30m\u001b[40m    \u001b[8;11H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[7b\u001b[33m\u001b[40m..\u001b[37m\u001b[40m...#\u001b[30m\u001b[40m   \u001b[36m\u001b[40m.\u001b[9;10H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m......\u001b[37m\u001b[40m...#\u001b[30m\u001b[40m \u001b[37m\u001b[40m#\u001b[36m\u001b[40m..\u001b[10;9H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[7b\u001b[37m\u001b[40m...#\u001b[36m\u001b[40m...\u001b[30m\u001b[40m \u001b[11;7H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m...\u001b(B\u001b[0m\u001b[32m\u001b[40m..\u001b[33m\u001b[40m..\u001b[32m\u001b[40m....\u001b[33m\u001b[40m...\u001b[32m\u001b[40m..\u001b[37m\u001b[40m...\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m.\u001b[30m\u001b[40m \u001b[36m\u001b[40m..\u001b[12;5H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m...\u001b(B\u001b[0m\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[37m\u001b[40m...#\u001b[36m\u001b[40m..\u001b[13;2H\u001b(B\u001b[0;1m\u001b[30m\u001b[40m....\u001b(B\u001b[0m\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m.\u001b[37m\u001b[40m...\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m...\u001b[30m\u001b[40m \r\u001b[14d\u001b(B\u001b[0;1m\u001b[30m\u001b[40m..\u001b(B\u001b[0m\u001b[32m\u001b[40m.\u001b[8b\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[37m\u001b[40m...#\r\u001b[15d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m.....\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[32m\u001b[40m...\u001b[33m\u001b[40m..\u001b[37m\u001b[40m...\u001b(B\u001b[0;1m\u001b[36m\u001b[40m\"\u001b(B\u001b[0m\u001b[36m\u001b[40m....\r\u001b[16d\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m...\u001b[32m\u001b[40m.\u001b[33m\u001b[40m..\u001b[16;18H\u001b[32m\u001b[40m.\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[32m\u001b[40m..\u001b[33m\u001b[40m.\u001b[37m\u001b[40m#\r\u001b[17d\u001b[32m\u001