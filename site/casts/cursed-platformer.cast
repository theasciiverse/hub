[0.000, "o", "     \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[13;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40m"]
[0.000, "o", "x\u000f\u001b[39;49m\u001b[37m\u001b[40m A message might provide a bit of textual\u001b[72G"]
[0.000, "o", "      \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[14;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40m"]
[0.000, "o", "x\u000f\u001b[39;49m\u001b[37m\u001b[40m exposition to advance my epic story. It might even   \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[15;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40m"]
[0.000, "o", "x\u000f\u001b[39;49m\u001b[37m\u001b[40m contain a hint for one of the brilliantly devious    \u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40mx\u000f\u001b[39;49m\u001b[37m\u001b[40m\u001b[16;23H\u001b[0m\u000e\u001b[39;49m\u001b[37m\u001b[40m"]
