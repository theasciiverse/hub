[0.017, "o", "\u001b[9;15H\u001b[38;2;255;176;0;48;2;8;8;12m╭──────────\u001b[9;76H──────────╮\u001b[10;15H│\u001b[39;48;2;8;8;12m          \u001b[10;76H          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[11;15H│\u001b[39;48;2;8;8;12m          \u001b[11;76H          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[12;15H│\u001b[39;48;2;8;8;12m          \u001b[12;76H          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[13;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mThe Games Folder: every game this machine ever played, and the one\u001b[39;48;2;8;8;12m  \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[14;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mit never did. Episode 3 is here, the game's home, and in here its\u001b[39;48;2;8;8;12m   \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[15;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mcreatures are bombers like Dot. They lay the game's own bombs,\u001b[39;48;2;8;8;12m      \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[16;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mpurple and round, and they don't care who is standing next to\u001b[39;48;2;8;8;12m       \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[17;15H│\u001b[39;48;2;8;8;12m  \u001b[38;2;230;230;236;48;2;8;8;12mthem. Twenty-two minutes to five. Beat the fizzes.\u001b[17;76H\u001b[39;48;2;8;8;12m          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[18;15H│\u001b[39;48;2;8;8;12m          \u001b[18;76H          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[19;15H│\u001b[39;48;2;8;8;12m          \u001b[19;76H          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[20;15H│\u001b[39;48;2;8;8;12m          \u001b[20;76H          \u001b[38;2;255;176;0;48;2;8;8;12m│\u001b[21;15H╰──────────\u001b[21;76H──────────╯\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
